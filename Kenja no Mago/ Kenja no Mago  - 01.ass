Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,SUB BY PUCUK DI EDIT DAN DI BD KAN OLEH KONEKO
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,Download Anime Batch Subtittle Indonesia Terlengkap Hanya di Kusonime.com
Dialogue: 0,0:00:09.17,0:00:11.78,Default,,0,0,0,,Akhirnya, selesai juga!
Dialogue: 0,0:00:12.28,0:00:13.99,Default,,0,0,0,,Kau bagaimana?
Dialogue: 0,0:00:14.28,0:00:16.24,Default,,0,0,0,,Kalau sudah selesai, mau ikut minum enggak?
Dialogue: 0,0:00:16.24,0:00:20.99,Default,,0,0,0,,Enggak deh, aku masih belum selesai. Kayaknya bakal lama ini, kalian duluan saja.
Dialogue: 0,0:00:21.29,0:00:23.37,Default,,0,0,0,,Begitu ya, okelah.
Dialogue: 0,0:00:23.37,0:00:24.92,Default,,0,0,0,,Jangan sampai lupa waktu.
Dialogue: 0,0:00:24.92,0:00:25.76,Default,,0,0,0,,Minum di mana?
Dialogue: 0,0:00:25.76,0:00:27.25,Default,,0,0,0,,Aku tahu tempat yang enak.
Dialogue: 0,0:00:32.66,0:00:34.51,Default,,0,0,0,,Enggak ada selesainya.
Dialogue: 0,0:00:34.80,0:00:38.35,Default,,0,0,0,,Yah, kalau pulang cepat juga tidak ada yang menungguku di rumah.
Dialogue: 0,0:00:38.35,0:00:40.35,Default,,0,0,0,,Paling cuma bisa nonton televisi,
Dialogue: 0,0:00:40.64,0:00:43.83,Default,,0,0,0,,atau melanjutkan game yang sedang kumainkan.
Dialogue: 0,0:00:46.84,0:00:49.15,Default,,0,0,0,,Akhirnya bisa pulang.
Dialogue: 0,0:00:53.43,0:00:58.63,Default,,0,0,0,,Di bumi ini ada banyak orang yang bernasib sepertiku.
Dialogue: 0,0:01:04.23,0:01:05.46,Default,,0,0,0,,Hei, kau ....
Dialogue: 0,0:01:07.44,0:01:09.42,Default,,0,0,0,,Awas!
Dialogue: 0,0:01:12.65,0:01:13.88,Default,,0,0,0,,Telepon ambulans!
Dialogue: 0,0:01:53.55,0:01:56.21,Default,,0,0,0,,Hore! Dapat makanan!
Dialogue: 0,0:01:59.58,0:02:03.66,Default Top,,0,0,0,,{\i1}Namaku adalah Shin Wolford.
Dialogue: 0,0:02:03.66,0:02:08.33,Default Italic,,0,0,0,,Di hutan ini aku tinggal dan hidup berdua dengan Kakek.
Dialogue: 0,0:02:10.48,0:02:12.69,Default Italic,,0,0,0,,Aku ingat tentang kehidupanku di masa lalu.
Dialogue: 0,0:02:12.69,0:02:16.90,Default Italic,,0,0,0,,Masa di mana aku dibesarkan di daerah Jepang yang berada di planet bernama Bumi.
Dialogue: 0,0:02:17.69,0:02:21.42,Default Italic,,0,0,0,,Walau aku tidak ingat bagaimana caraku mati.
Dialogue: 0,0:02:22.62,0:02:24.49,Default,,0,0,0,,Aku pulang!
Dialogue: 0,0:02:25.37,0:02:27.00,Default,,0,0,0,,Oh, selamat datang.
Dialogue: 0,0:02:27.00,0:02:29.25,Default Top,,0,0,0,,Bagaimana hasil buruan hari ini?
Dialogue: 0,0:02:29.25,0:02:32.00,Default Top,,0,0,0,,{\i1}Kakek ini namanya Merlin Wolford.
Dialogue: 0,0:02:32.58,0:02:35.55,Default Italic,,0,0,0,,Aku yang berhasil selamat akibat serangan Iblis,
Dialogue: 0,0:02:35.55,0:02:40.68,Default Italic,,0,0,0,,dari bayi dibesarkan olehnya, bisa dibilang dialah penyelamat hidupku.
Dialogue: 0,0:02:40.68,0:02:44.22,Default,,0,0,0,,Oh, tiga ekor ayam dan satu babi hutan ya?
Dialogue: 0,0:02:44.22,0:02:46.68,Default,,0,0,0,,Berburu berlebihan juga tidak baik, 'kan?
Dialogue: 0,0:02:47.02,0:02:48.52,Default,,0,0,0,,Tebasan bilah angin.
Dialogue: 0,0:02:48.52,0:02:50.77,Default,,0,0,0,,Kerja bagus.
Dialogue: 0,0:02:50.77,0:02:53.23,Default,,0,0,0,,Itu sihir yang paling cocok untuk berburu soalnya.
Dialogue: 0,0:02:53.23,0:02:57.98,Default Italic,,0,0,0,,Berbeda dari dunia tempatku hidup sebelumnya, Sihir benar-benar nyata di dunia ini.
Dialogue: 0,0:02:58.61,0:03:00.74,Default Italic,,0,0,0,,Kakek juga sepertinya sangat ahli dalam sihir,
Dialogue: 0,0:03:01.15,0:03:03.03,Default Italic,,0,0,0,,jadi aku banyak diajari olehnya.
Dialogue: 0,0:03:03.03,0:03:04.99,Default,,0,0,0,,Kalau begitu, bagaimana dengan sihir api?
Dialogue: 0,0:03:05.41,0:03:07.16,Default,,0,0,0,,Shin, coba bakar itu.
Dialogue: 0,0:03:07.16,0:03:08.08,Default,,0,0,0,,Ya!
Dialogue: 0,0:03:08.08,0:03:11.08,Default Italic,,0,0,0,,Sihir bekerja di dunia ini tanpa perlu melafalkan mantera.
Dialogue: 0,0:03:11.08,0:03:14.21,Default Italic,,0,0,0,,Jadi kau hanya perlu membayangkannya saja.
Dialogue: 0,0:03:16.71,0:03:21.13,Default Italic,,0,0,0,,Jujur, aku benar-benar tertolong, berdasarkan ingatanku tentang dunia sebelumnya,
Dialogue: 0,0:03:19.49,0:03:26.14,Default Top,,0,0,0,,Bakar habis musuhku, serangan api!
Dialogue: 0,0:03:21.13,0:03:26.14,Default Italic,,0,0,0,,kalau sampai perlu mengucapkan mantera keras-keras begitu, bikin malu yang ada.
Dialogue: 0,0:03:27.43,0:03:30.06,Default,,0,0,0,,Nenek Melida sama pak Michel datang!
Dialogue: 0,0:03:30.06,0:03:32.98,Default,,0,0,0,,Shin, kau jangan hanya belajar sihirku.
Dialogue: 0,0:03:32.98,0:03:36.11,Default,,0,0,0,,Alat sihir dan ilmu pedang juga harus kau pelajari.
Dialogue: 0,0:03:36.40,0:03:37.86,Default,,0,0,0,,Ya!
Dialogue: 0,0:03:39.38,0:03:41.28,Default,,0,0,0,,Babi hutan kau bilang?
Dialogue: 0,0:03:41.28,0:03:44.24,Default,,0,0,0,,Shin, kau kenapa melakukan hal berbahaya begini?!
Dialogue: 0,0:03:44.24,0:03:49.24,Default Top,,0,0,0,,{\i1}Orang ini namanya Melida Bowen, dia temannya Kakek dan sering mampir kemari.
Dialogue: 0,0:03:49.66,0:03:51.87,Default,,0,0,0,,Tidak berbahaya sama sekali kok.
Dialogue: 0,0:03:51.87,0:03:55.58,Default,,0,0,0,,Kan ada alat sihir yang kita buat bersama.
Dialogue: 0,0:03:55.58,0:03:59.59,Default,,0,0,0,,Dasar, memang di dunia macam apa ada anak delapan tahun yang beburu babi hutan sendiri?
Dialogue: 0,0:03:59.59,0:04:00.76,Default,,0,0,0,,Ini.
Dialogue: 0,0:04:00.76,0:04:01.59,Default,,0,0,0,,Dasar bego!
Dialogue: 0,0:04:01.59,0:04:04.55,Default,,0,0,0,,Kau juga tahu 'kan bakat sihir milik Shin.
Dialogue: 0,0:04:04.89,0:04:08.43,Default,,0,0,0,,Hutan ini sudah seperti halaman belakang bagi Shin.
Dialogue: 0,0:04:08.43,0:04:11.14,Default Top,,0,0,0,,Tapi, mengejutkan juga kau bisa mengalahkan babi hutan!
Dialogue: 0,0:04:11.14,0:04:14.19,Default Top,,0,0,0,,Sepertinya latihan kita harus lebih ditingkatkan lagi.
Dialogue: 0,0:04:14.19,0:04:18.36,Default,,0,0,0,,Eh? Jangan dong!
Dialogue: 0,0:04:23.74,0:04:25.20,Default,,0,0,0,,Berburu Iblis?
Dialogue: 0,0:04:25.49,0:04:29.95,Default,,0,0,0,,Kau sudah berumur 10 tahun juga, jadi sekarang waktunya menambah pengalamanmu.
Dialogue: 0,0:04:30.41,0:04:31.87,Default,,0,0,0,,Lawan Iblis ya?
Dialogue: 0,0:04:31.87,0:04:37.33,Default,,0,0,0,,Dunia ini dipenuhi dengan energi sihir, sehingga menguntungkan semua makhluk yang ada.
Dialogue: 0,0:04:37.33,0:04:40.75,Default,,0,0,0,,Tapi begitu gagal mengendalikannya, makhluk itu akan jadi liar
Dialogue: 0,0:04:40.75,0:04:44.72,Default,,0,0,0,,dan menyerang segala sesuatu tanpa pandang bulu, itulah yang dinamakan Iblis.
Dialogue: 0,0:04:45.13,0:04:47.30,Default,,0,0,0,,Manusia juga bisa jadi seperti itu.
Dialogue: 0,0:04:47.30,0:04:51.77,Default,,0,0,0,,Dulu katanya, ada orang yang jadi Iblis dan hampir menghancurkan seluruh negeri.
Dialogue: 0,0:04:51.77,0:04:54.23,Default,,0,0,0,,Dan yang menyelamatkannya adalah Kakek, 'kan?
Dialogue: 0,0:04:54.23,0:04:56.48,Default,,0,0,0,,Bahkan sampai sekarang, di sana Kakek masih disebut Pahlawan.
Dialogue: 0,0:04:58.09,0:05:00.73,Default,,0,0,0,,Baiklah, bagaimana kalau segera kita mulai?
Dialogue: 0,0:05:00.73,0:05:03.28,Default,,0,0,0,,Pertama-tama, kita harus mencari Iblis.
Dialogue: 0,0:05:03.28,0:05:04.44,Default,,0,0,0,,Bagaimana caranya?
Dialogue: 0,0:05:05.20,0:05:08.03,Default,,0,0,0,,Dengan cara menyebarkan energi sihirmu ke sekitar.
Dialogue: 0,0:05:08.32,0:05:12.29,Default,,0,0,0,,Saat energi ini bersentuhan dengan energi sihir lain, maka kau akan merasakannya.
Dialogue: 0,0:05:12.29,0:05:14.87,Default,,0,0,0,,Semua makhluk hidup memiliki energi sihir,
Dialogue: 0,0:05:14.87,0:05:17.87,Default,,0,0,0,,jadi kalau terjadi sesuatu, kau bisa langsung tahu letaknya.
Dialogue: 0,0:05:17.87,0:05:20.04,Default,,0,0,0,,Ini namanya "Sihir Pencari."
Dialogue: 0,0:05:20.04,0:05:26.13,Default,,0,0,0,,Walau begitu, hal ini sulit dilakukan tanpa pengendalian sihir yang baik.
Dialogue: 0,0:05:33.14,0:05:36.98,Default,,0,0,0,,Hebat! Aku bisa melihat seluruh makhluk hutan ...,
Dialogue: 0,0:05:36.98,0:05:40.23,Default,,0,0,0,,bahkan sampai Nenek Melida di rumahnya!
Dialogue: 0,0:05:40.52,0:05:44.44,Default Italic,,0,0,0,,Oh, aku tahu dia berbakat tapi tak kusangka akan langsung bisa melakukannya.
Dialogue: 0,0:05:45.86,0:05:49.45,Default Italic,,0,0,0,,Perasaan buruk apa ini?
Dialogue: 0,0:05:49.45,0:05:53.54,Default,,0,0,0,,Oh, kau menemukannya ya? Itu adalah energi sihir milik Iblis.
Dialogue: 0,0:05:53.54,0:05:55.41,Default,,0,0,0,,Kakek, ayo bergegas!
Dialogue: 0,0:05:55.41,0:05:57.96,Default,,0,0,0,,Kalau dibiarkan bisa terjadi hal buruk nanti!
Dialogue: 0,0:05:58.37,0:06:01.71,Default,,0,0,0,,Benar. Ini mungkin akan berbahaya.
Dialogue: 0,0:06:14.58,0:06:16.89,Default,,0,0,0,,Itukah Iblis?
Dialogue: 0,0:06:17.43,0:06:18.98,Default,,0,0,0,,Kalau kita biarkan begitu saja ....
Dialogue: 0,0:06:19.98,0:06:22.06,Default,,0,0,0,,Tu-Tunggu dulu!
