Dialogue: 1,0:21:15.90,0:21:19.86,ED - Rom,,0,0,0,,{\blur2.5}mugen no kanousei ga hohoenda
Dialogue: 0,0:21:15.90,0:21:19.86,ED - Eng,,0,0,0,,{\blur0.9}Untuk menyampai kebahagian yang terbatas
Dialogue: 0,0:21:20.19,0:21:22.95,ED - Rom,,0,0,0,,{\blur2.5}Kasokudo age mune wo hazume
Dialogue: 0,0:21:20.19,0:21:22.95,ED - Eng,,0,0,0,,{\blur0.9}Busungkan dada dan lakukan dengan cepat
Dialogue: 0,0:21:22.95,0:21:25.82,ED - Rom,,0,0,0,,{\blur2.5}tokutou seki e Here we go, Jump!
Dialogue: 0,0:21:22.95,0:21:25.82,ED - Eng,,0,0,0,,{\blur0.9}Rebut tempat istimewa itu, kita lakukan sekarang, Jump!
Dialogue: 0,0:21:25.82,0:21:29.70,ED - Rom,,0,0,0,,{\blur2.5}karada wo irodoru tenshon atsuku
Dialogue: 0,0:21:25.82,0:21:29.70,ED - Eng,,0,0,0,,{\blur0.9}Ketegangan yang menyelimuti tubuh ini
Dialogue: 0,0:21:30.04,0:21:32.79,ED - Rom,,0,0,0,,{\blur2.5}kankaku dake sukuiageta
Dialogue: 0,0:21:30.04,0:21:32.79,ED - Eng,,0,0,0,,{\blur0.9}Hanya perasaan yang aku rasakan
Dialogue: 0,0:21:32.79,0:21:36.50,ED - Rom,,0,0,0,,{\blur2.5}konshin no ichigeki de Show up!
Dialogue: 0,0:21:32.79,0:21:36.50,ED - Eng,,0,0,0,,{\blur0.9}Di dalam tubuhku hanya ada satu pukulan: Show up!
Dialogue: 0,0:21:36.50,0:21:40.17,ED - Rom,,0,0,0,,{\blur2.5}boku wa issou kagayaketa
Dialogue: 0,0:21:36.50,0:21:40.17,ED - Eng,,0,0,0,,{\blur0.9}Aku semakin bersinar
Dialogue: 0,0:21:40.17,0:21:44.84,ED - Rom,,0,0,0,,{\blur2.5}ikiru imi wo atsumeru hodo ni
Dialogue: 0,0:21:40.17,0:21:44.84,ED - Eng,,0,0,0,,{\blur0.9}Sambil mengumpulkan alasan untuk hidup
Dialogue: 0,0:21:44.84,0:21:49.68,ED - Rom,,0,0,0,,{\blur2.5}saikou & saikyou nichijou no kyasutingu de
Dialogue: 0,0:21:44.84,0:21:49.68,ED - Eng,,0,0,0,,{\blur0.9}Yang terhebat dan terkuat dalam keseharian
Dialogue: 0,0:21:49.68,0:21:54.02,ED - Rom,,0,0,0,,{\blur2.5}Sensation na sutoorii wo Shout out!
Dialogue: 0,0:21:49.68,0:21:54.02,ED - Eng,,0,0,0,,{\blur0.9}Membuat cerita yang menegangkan: Shout out!
Dialogue: 0,0:21:55.15,0:21:57.44,ED - Rom,,0,0,0,,{\blur2.5}Don’t worry! unmei wa taezu
Dialogue: 0,0:21:55.15,0:21:57.44,ED - Eng,,0,0,0,,{\blur0.9}Jangan khawatir! Nasib itu pasti
Dialogue: 0,0:21:57.44,0:21:59.86,ED - Rom,,0,0,0,,{\blur2.5}Everything, Everything hana saku
Dialogue: 0,0:21:57.44,0:21:59.86,ED - Eng,,0,0,0,,{\blur0.9}Semua nya akan bermekaran
Dialogue: 0,0:22:00.48,0:22:04.99,ED - Rom,,0,0,0,,{\blur2.5}umarekawattemo nanmankai mo hikarun da
Dialogue: 0,0:22:00.48,0:22:04.99,ED - Eng,,0,0,0,,{\blur0.9}Jika aku di lahirkan kembali, aku akan lebih kuat seribu kali
Dialogue: 0,0:22:04.99,0:22:07.41,ED - Rom,,0,0,0,,{\blur2.5}Be happy! sekai wo ima
Dialogue: 0,0:22:04.99,0:22:07.41,ED - Eng,,0,0,0,,{\blur0.9}Berbahagiahlah! Di kehidupan sekarang
Dialogue: 0,0:22:07.41,0:22:09.83,ED - Rom,,0,0,0,,{\blur2.5}Everything, Everything tanoshime
Dialogue: 0,0:22:07.41,0:22:09.83,ED - Eng,,0,0,0,,{\blur0.9}Semua nya akan terasa menyenangkan
Dialogue: 0,0:22:10.33,0:22:15.54,ED - Rom,,0,0,0,,{\blur2.5}erabi tsuzukeyou seikai wo kono te ni tsuyoku
Dialogue: 0,0:22:10.33,0:22:15.54,ED - Eng,,0,0,0,,{\blur0.9}Aku akan memilih kehidupan yang kuat di tangan ini
Dialogue: 0,0:22:15.54,0:22:20.00,ED - Rom,,0,0,0,,{\blur2.5}Now or never! shinpai gomuyou
Dialogue: 0,0:22:15.54,0:22:20.00,ED - Eng,,0,0,0,,{\blur0.9}Sekarang atau tidak sama sekali! Jangan pernah khawatir
Dialogue: 0,0:22:20.50,0:22:25.83,ED - Rom,,0,0,0,,{\blur2.5}Happy ending mukaeru kara
Dialogue: 0,0:22:20.50,0:22:25.83,ED - Eng,,0,0,0,,{\blur0.9}Akhir yang bahagia, karena kita bertemu
Dialogue: 0,0:00:00.98,0:00:02.94,TS,,0,0,0,,{\fs40\fsp-2\fscx90\fsp-3\an4\blur0.7\shad1\pos(84,170)}Kediaman Cabang Claude
Dialogue: 0,0:00:06.48,0:00:08.90,Default Italic,,0,0,0,,Kejadian kemarin sungguh membekas,
Dialogue: 0,0:00:09.28,0:00:11.15,Default Italic,,0,0,0,,aku jadi tidak bisa tidur.
Dialogue: 0,0:00:19.58,0:00:21.83,Default,,0,0,0,,Se-Selamat pagi ....
Dialogue: 0,0:00:21.83,0:00:23.29,Default,,0,0,0,,Selamat pagi ....
Dialogue: 0,0:00:23.96,0:00:30.84,Default,,0,0,0,,A-Ayo kita ke ruang makan. Nanti keburu dingin sarapannya.
Dialogue: 0,0:00:31.17,0:00:35.26,Default,,0,0,0,,Be-Benar juga. Eh, Shin ....
Dialogue: 0,0:00:36.43,0:00:42.06,Default,,0,0,0,,Ada waktu sebentar? Aku ingin meminta tolong.
Dialogue: 0,0:02:12.98,0:02:19.91,TS,,0,0,0,,{\fs40\fsp-2\fscx90\fsp-3\an4\blur0.7\shad1\pos(932,184)}Kediaman Claude
Dialogue: 0,0:02:14.78,0:02:19.91,Default,,0,0,0,,Maaf ya Shin, pagi-pagi begini sudah meminta tolong padamu.
Dialogue: 0,0:02:20.28,0:02:23.91,Default,,0,0,0,,Kalau tidak bergegas, nanti Ayahku keburu berangkat kerja soalnya.
Dialogue: 0,0:02:24.29,0:02:28.50,Default,,0,0,0,,Kita memang harus mengatakan soal ini pada kedua orang tuamu.
Dialogue: 0,0:02:29.75,0:02:30.46,Default,,0,0,0,,Iya.
Dialogue: 0,0:02:32.09,0:02:35.59,Default Italic,,0,0,0,,Walau sudah bilang begitu, pas ketemu langsung ....
Dialogue: 0,0:02:35.59,0:02:43.10,TS,,0,0,0,,{\fs50\fsp-2\fad(0,450)\fscx90\fsp-3\an4\blur0.7\shad1\pos(94,540)}Irene von Claude
Dialogue: 0,0:02:35.59,0:02:43.10,TS,,0,0,0,,{\fs50\fsp-2\fscx90\fad(0,450)\fsp-3\an4\blur0.7\shad1\pos(768,540)}Cecil von Claude
Dialogue: 0,0:02:36.51,0:02:39.18,Default Top,,0,0,0,,Jadi, apa yang ingin dibicarakan?
Dialogue: 0,0:02:39.72,0:02:43.43,Default Top,,0,0,0,,Sampai kalian dari perkemahan latihan, datang jauh-jauh kemari.
Dialogue: 0,0:02:43.43,0:02:45.60,Default Top,,0,0,0,,Pasti ini hal yang sangat penting ya.
Dialogue: 0,0:02:48.85,0:02:49.81,Default,,0,0,0,,Sebenarnya ...
Dialogue: 0,0:02:52.86,0:02:56.82,Default,,0,0,0,,... Sicily terlah bersedia untuk menjadi kekasihku.
Dialogue: 0,0:02:57.49,0:03:02.20,Default,,0,0,0,,Sehingga hari ini, aku datang untuk meminta restu dari kalian.
Dialogue: 0,0:03:06.24,0:03:07.12,Default,,0,0,0,,Shin ....
Dialogue: 0,0:03:07.83,0:03:08.66,Default,,0,0,0,,Iya?
Dialogue: 0,0:03:11.04,0:03:15.92,Default,,0,0,0,,Terima kasih! Terima kasih banyak telah memilih Sicily!
Dialogue: 0,0:03:16.50,0:03:16.96,Default Italic,,0,0,0,,Eh?!
Dialogue: 0,0:03:20.80,0:03:25.18,Default,,0,0,0,,Wah, padahal masih pagi tetapi hari sudah terlihat sangat indah!
Dialogue: 0,0:03:25.18,0:03:27.52,Default,,0,0,0,,Sampai bisa mendengar berita bahagia ini!
Dialogue: 0,0:03:28.18,0:03:29.10,Default,,0,0,0,,Suamiku ....
Dialogue: 0,0:03:30.10,0:03:31.27,Default,,0,0,0,,A-Apa?
Dialogue: 0,0:03:31.27,0:03:33.60,Default,,0,0,0,,Bisa tolong duduk dulu?
Dialogue: 0,0:03:33.60,0:03:34.94,Default,,0,0,0,,Eh, baik.
Dialogue: 0,0:03:38.44,0:03:43.53,Default,,0,0,0,,Sebelum kurestui hubunganmu dengan Sicily, ada yang ingin kutanyakan.
Dialogue: 0,0:03:44.03,0:03:44.95,Default,,0,0,0,,Tidak apa-apa, 'kan?
Dialogue: 0,0:03:45.41,0:03:46.99,Default,,0,0,0,,Iya, ada apa?
Dialogue: 0,0:03:49.08,0:03:51.66,Default,,0,0,0,,Kami adalah keluarga bangsawan.
Dialogue: 0,0:03:51.66,0:03:53.62,Default,,0,0,0,,Walau Sicily anak ketiga kami,
Dialogue: 0,0:03:53.62,0:03:57.30,Default,,0,0,0,,apa yang menantinya masih tetap dalam pertimbangan.
Dialogue: 0,0:03:57.30,0:03:59.21,Default,,0,0,0,,Maksud yang menanti baginya itu ....
Dialogue: 0,0:04:00.13,0:04:01.34,Default,,0,0,0,,Pernikahan.
Dialogue: 0,0:04:03.34,0:04:05.22,Default,,0,0,0,,Aku tidak bilang harus langsung dilakukan.
Dialogue: 0,0:04:05.68,0:04:06.39,Default,,0,0,0,,Tetapi,
Dialogue: 0,0:04:06.39,0:04:10.68,Default,,0,0,0,,anak seorang bangsawan tak diperkenankan untuk berpacaran tanpa bertunangan.
Dialogue: 0,0:04:12.73,0:04:15.48,Default,,0,0,0,,Sepertinya, kau sudah mempersiapkan diri ya.
Dialogue: 0,0:04:15.77,0:04:16.36,Default,,0,0,0,,Iya.
Dialogue: 0,0:04:17.02,0:04:18.48,Default,,0,0,0,,Shin ....
Dialogue: 0,0:04:19.23,0:04:20.82,Default,,0,0,0,,Selamat ya, Sicily.
Dialogue: 0,0:04:22.36,0:04:24.70,Default,,0,0,0,,Keinginanmu akhirnya terkabul juga.
Dialogue: 0,0:04:25.07,0:04:28.45,Default,,0,0,0,,Te-Terima kasih, Ibunda.
Dialogue: 0,0:04:28.99,0:04:33.79,Default,,0,0,0,,Oh! Tapi jangan bilang itu di depan Shin dong!
Dialogue: 0,0:04:44.05,0:04:45.26,Default,,0,0,0,,Lumayan juga, Thor.
Dialogue: 0,0:04:45.72,0:04:46.89,Default,,0,0,0,,Kau juga Tony.
Dialogue: 0,0:04:47.35,0:04:50.85,Default,,0,0,0,,Sihir jenis apa yang mereka keluarkan?!
Dialogue: 0,0:04:50.85,0:04:53.89,Default,,0,0,0,,Pemanasan sudah cukup sepertinya.
Dialogue: 0,0:04:53.89,0:04:54.64,Default,,0,0,0,,Eh?!
Dialogue: 0,0:04:56.85,0:05:01.11,Default,,0,0,0,,Bagaimana? Karena nona muda sudah kebetulan datang kemari.
Dialogue: 0,0:05:01.61,0:05:04.36,Default,,0,0,0,,Apa kalian juga ingin mencobanya?
Dialogue: 0,0:05:05.78,0:05:08.74,Default,,0,0,0,,Kalau aku sepertinya harus menolak.
Dialogue: 0,0:05:09.28,0:05:12.25,Default,,0,0,0,,Mengingat kecocokanku dengan sihir kurang baik.
Dialogue: 0,0:05:12.54,0:05:14.41,Default,,0,0,0,,Kalau aku mau mencobanya!
Dialogue: 0,0:05:14.87,0:05:19.21,Default,,0,0,0,,Baiklah, mari kita mulai dari kendali sihir dasar.
Dialogue: 0,0:05:20.21,0:05:24.42,Default,,0,0,0,,Wa-Wah, hebat! Energi sihirnya banyak sekali!
Dialogue: 0,0:05:25.01,0:05:27.76,Default,,0,0,0,,Oh, luar biasa juga kau.
Dialogue: 0,0:05:27.76,0:05:30.39,Default,,0,0,0,,Di umur semuda ini kapasitasnya besar juga.
Dialogue: 0,0:05:31.26,0:05:35.56,Default,,0,0,0,,Sepertinya May punya bakat sebagai penyihir ya.
Dialogue: 0,0:05:37.23,0:05:42.11,Default,,0,0,0,,Apa jangan-jangan, nanti Putri May akan jadi penyihir yang hebat di masa depan?
Dialogue: 0,0:05:42.11,0:05:44.49,Default,,0,0,0,,Aku takkan kalah! Semangat!
Dialogue: 0,0:05:46.90,0:05:50.37,Default,,0,0,0,,May sudah menginspirasimu ya.
Dialogue: 0,0:05:51.41,0:05:55.00,Default,,0,0,0,,Lynn, kau terlalu berlebihan lagi.
Dialogue: 0,0:05:55.00,0:05:55.83,Default,,0,0,0,,Lah?
Dialogue: 0,0:06:02.75,0:06:04.67,Default,,0,0,0,,Sudah kubilang tadi.
Dialogue: 0,0:06:05.80,0:06:12.64,Default,,0,0,0,,Kalian semua harus berjuang supaya tidak dilampaui oleh May dalam banyak hal ya.
Dialogue: 0,0:06:13.01,0:06:15.93,Default,,0,0,0,,Dalam banyak hal ....
Dialogue: 0,0:06:18.14,0:06:18.77,Default,,0,0,0,,Tatap!
Dialogue: 0,0:06:22.02,0:06:26.49,Default,,0,0,0,,Kenapa malah sembunyi di belakang Shin dan bukan di belakang kakakmu sendiri?
Dialogue: 0,0:06:27.65,0:06:30.53,Default,,0,0,0,,Sepertinya kau perlu dihukum ya.
Dialogue: 0,0:06:30.53,0:06:34.49,Default,,0,0,0,,Wah! Kak Shin, tolong lindungi aku!
Dialogue: 0,0:06:34.49,0:06:37.29,Default,,0,0,0,,Kalian semua tidak ada yang beres ya.
Dialogue: 0,0:06:38.12,0:06:38.91,Default,,0,0,0,,Aku bercanda.
Dialogue: 0,0:06:39.37,0:06:40.50,Default,,0,0,0,,Yakin?
Dialogue: 0,0:06:41.50,0:06:43.67,TS,,0,0,0,,{\fs40\fsp-2\fad(450,0)\fscx90\fsp-3\an4\blur0.7\shad1\pos(82,192)}Ibu Kota Kekaisaran
Dialogue: 0,0:06:42.63,0:06:43.67,Default,,0,0,0,,Miria,
Dialogue: 0,0:06:44.42,0:06:46.63,Default,,0,0,0,,bagaimana prosesnya?
Dialogue: 0,0:06:47.13,0:06:50.13,Default,,0,0,0,,Dengan serangan pada karavan di jalan,
Dialogue: 0,0:06:50.13,0:06:53.51,Default,,0,0,0,,kota di sekitar Kekaisaran mulai kekurangan makanan,
Dialogue: 0,0:06:53.51,0:06:55.72,Default,,0,0,0,,sehingga kebencian mereka semakin meningkat.
Dialogue: 0,0:06:56.72,0:07:01.19,Default,,0,0,0,,Sepertinya, waktunya sudah tepat ya ....
Dialogue: 0,0:07:04.73,0:07:07.61,Default,,0,0,0,,Kenapa kalian pakai pelindung begitu?
Dialogue: 0,0:07:07.61,0:07:12.16,Default,,0,0,0,,Habisnya, Wolford, kau mau menguji coba sihir baru, 'kan?
Dialogue: 0,0:07:12.62,0:07:16.33,Default,,0,0,0,,Kami tidak mau terkena dampaknya sampai terhempas jauh.
Dialogue: 0,0:07:16.33,0:07:17.83,Default,,0,0,0,,Jadi ini buat jaga-jaga.
Dialogue: 0,0:07:18.16,0:07:21.67,Default,,0,0,0,,May, kali ini pastikan kau sembunyi di belakangku ya.
Dialogue: 0,0:07:21.83,0:07:22.50,Default,,0,0,0,,Baik.
Dialogue: 0,0:07:25.63,0:07:28.55,Default,,0,0,0,,Kali ini takkan sebahaya itu kok.
Dialogue: 0,0:07:28.71,0:07:30.01,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:07:30.88,0:07:34.64,Default,,0,0,0,,Ini bukan sihir tipe serangan kok, tenang saja deh.
Dialogue: 0,0:07:34.64,0:07:36.39,Default,,0,0,0,,Oh begitu, baiklah.
Dialogue: 0,0:07:39.98,0:07:43.85,Default,,0,0,0,,Energi sihir yang terkumpul luar biasa ya.
Dialogue: 0,0:07:44.27,0:07:47.11,Default,,0,0,0,,Ya-Yakin ini tidak berbahaya?
Dialogue: 0,0:07:52.61,0:07:55.45,Default,,0,0,0,,Oh, akhirnya berhasil!
Dialogue: 0,0:08:00.79,0:08:04.17,Default,,0,0,0,,Ini sebenarnya tipe sihir jenis apa?
Dialogue: 0,0:08:04.96,0:08:09.71,Default,,0,0,0,,Sihir mengambang. Batunya kuberi anti gravitasi .... Eh,
Dialogue: 0,0:08:09.71,0:08:13.13,Default,,0,0,0,,kuberi bayangan lawan dari barang terjatuh.
Dialogue: 0,0:08:13.55,0:08:16.35,Default,,0,0,0,,Seperti biasa, aku tidak mengerti.
Dialogue: 0,0:08:16.35,0:08:19.85,Default,,0,0,0,,Tapi yang kutahu kau sudah melakukan hal luar biasa lainnya.
Dialogue: 0,0:08:20.18,0:08:22.48,Default,,0,0,0,,Yang luar biasa harusnya ini.
Dialogue: 0,0:08:29.86,0:08:30.48,Default,,0,0,0,,Eh?
Dialogue: 0,0:08:31.15,0:08:34.36,Default Italic,,0,0,0,,Dengan memakai mengambang pada diriku,
Dialogue: 0,0:08:34.70,0:08:38.08,Default Italic,,0,0,0,,lalu mengaplikasikan sihir angin untuk bergerak ke samping ....
Dialogue: 0,0:08:40.45,0:08:42.29,Default,,0,0,0,,Ini seru juga!
Dialogue: 0,0:08:42.75,0:08:44.37,Default,,0,0,0,,Asyik!
Dialogue: 0,0:08:46.42,0:08:49.42,Default,,0,0,0,,Uji coba kali ini berhasil lagi.
Dialogue: 0,0:08:49.42,0:08:52.72,Default,,0,0,0,,Tindakanmu di luar dugaan lagi ....
Dialogue: 0,0:08:52.72,0:08:56.93,Default,,0,0,0,,Masa? Schtrom juga bisa memakainya. Ini itu untuk melawannya.
Dialogue: 0,0:08:57.18,0:08:59.39,Default,,0,0,0,,Shin hebat!
Dialogue: 0,0:09:00.06,0:09:05.19,Default,,0,0,0,,Kak Shin, aku juga ingin terbang, ajari dong!
Dialogue: 0,0:09:05.60,0:09:08.44,Default,,0,0,0,,Ja-Jangan, Putri May!
Dialogue: 0,0:09:08.44,0:09:09.40,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:09:09.61,0:09:11.15,Default,,0,0,0,,Habis, kalau terbang sekarang ....
Dialogue: 0,0:09:11.73,0:09:12.53,Default,,0,0,0,,Kalau terbang?
Dialogue: 0,0:09:12.78,0:09:15.49,Default,,0,0,0,,Nanti celana dalam milikmu kelihatan sama semuanya !
Dialogue: 0,0:09:20.62,0:09:23.29,Default,,0,0,0,,Apa?! Kau langsung bertunangan?
Dialogue: 0,0:09:23.79,0:09:27.25,Default,,0,0,0,,Kakek, Nenek, maaf ya aku tidak langsung bilang.
Dialogue: 0,0:09:27.83,0:09:33.21,Default,,0,0,0,,Aku juga salah karena ingin segera mengatakan hubungan kami pada orang tuaku.
Dialogue: 0,0:09:33.80,0:09:37.64,Default,,0,0,0,,Oh, tidak, kami tidak menyalahkan kalian kok.
Dialogue: 0,0:09:37.64,0:09:41.72,Default,,0,0,0,,Ya, suatu saat ini sudah kami duga akan terjadi.
Dialogue: 0,0:09:41.72,0:09:43.56,Default,,0,0,0,,Jadi bukan hal yang mengejutkan kok.
Dialogue: 0,0:09:45.14,0:09:49.56,Default,,0,0,0,,Tapi, sebelum mengumumkan secara publik,
Dialogue: 0,0:09:49.56,0:09:52.11,Default,,0,0,0,,ada sesuatu yang harus dilakukan.
Dialogue: 0,0:09:55.78,0:10:00.24,Default,,0,0,0,,Sicily, maaf harus selarut ini, tapi aku harus mengunjungi keluargamu.
Dialogue: 0,0:10:00.53,0:10:02.49,Default,,0,0,0,,Ne-Nenek, jangan-jangan ....
Dialogue: 0,0:10:02.99,0:10:03.54,Default,,0,0,0,,Ya.
Dialogue: 0,0:10:05.00,0:10:09.00,TS,,0,0,0,,{\fs40\fsp-2\fad(450,0)\fscx90\fsp-3\an4\blur0.7\shad1\pos(86,540)}Kediaman Claude, Aula Pintu Masuk
Dialogue: 0,0:10:05.62,0:10:09.00,Default Top,,0,0,0,,Astaga, tak kusangka Pria Bijak dan Guru Cakap ...
Dialogue: 0,0:10:09.50,0:10:12.04,Default Top,,0,0,0,,... sampai mau mengunjungi kediamanku.
Dialogue: 0,0:10:12.46,0:10:15.26,Default,,0,0,0,,Kami tadinya ingin datang di lain hari,
Dialogue: 0,0:10:15.26,0:10:17.13,Default,,0,0,0,,tapi mungkin lebih cepat lebih baik.
Dialogue: 0,0:10:17.80,0:10:20.89,Default,,0,0,0,,Ada yang ingin kami bicarakan dengan kalian berdua.
Dialogue: 0,0:10:23.76,0:10:24.64,Default,,0,0,0,,Jadi,
Dialogue: 0,0:10:25.02,0:10:26.93,Default,,0,0,0,,seperti itulah keadaan sebenarnya.
Dialogue: 0,0:10:27.56,0:10:29.44,Default,,0,0,0,,Jadi, Shin ternyata ....
Dialogue: 0,0:10:30.60,0:10:33.32,Default,,0,0,0,,Bukanlah cucu kandung kami.
Dialogue: 0,0:10:37.95,0:10:43.53,Default,,0,0,0,,Persetujuan kalian atas pertunangan ini, maaf sebelumnya,
Dialogue: 0,0:10:43.53,0:10:47.04,Default,,0,0,0,,mungkin sebagian besar karena Shin adalah cucu kami.
Dialogue: 0,0:10:48.12,0:10:51.71,Default,,0,0,0,,Tapi, sebenarnya kami tidak memiliki hubungan darah dengan anak ini.
Dialogue: 0,0:10:52.67,0:10:57.34,Default,,0,0,0,,Apakah kalian akan tetap menyetujui Shin sebagai tunangannya Sicily?
Dialogue: 0,0:10:59.13,0:11:04.85,Default,,0,0,0,,Nona Melida, Tuan Merlin, sebenarnya, aku merasa kecewa.
Dialogue: 0,0:11:09.10,0:11:11.52,Default,,0,0,0,,Sepertinya, memang begitu ya ....
Dialogue: 0,0:11:11.52,0:11:13.65,Default,,0,0,0,,Apa boleh buat.
Dialogue: 0,0:11:14.61,0:11:17.99,Default,,0,0,0,,Kuminta kalian agar tidak merendahkan kami lebih dari ini!
Dialogue: 0,0:11:19.36,0:11:22.99,Default,,0,0,0,,Alasan kami berdua merestui pertunangan dengan Shin ...
Dialogue: 0,0:11:23.82,0:11:26.33,Default,,0,0,0,,... bukanlah karena dia cucu dari kalian berdua.
Dialogue: 0,0:11:27.33,0:11:31.58,Default,,0,0,0,,Tapi karena dia menghargai Sicily lebih dari apa pun, serta berusaha untuk melindunginya.
Dialogue: 0,0:11:32.00,0:11:36.59,Default,,0,0,0,,Justru karena kepribadiannya itu kami menyetujui pertunangan ini.
Dialogue: 0,0:11:37.59,0:11:39.84,Default,,0,0,0,,Keputusan ini dibuat demi anak kami.
Dialogue: 0,0:11:40.38,0:11:42.26,Default,,0,0,0,,Suamiku benar.
Dialogue: 0,0:11:44.60,0:11:49.02,Default,,0,0,0,,Aku mohon maaf sudah salah sangka, harap maklum.
Dialogue: 0,0:11:49.39,0:11:50.77,Default,,0,0,0,,Oh, tidak usah!
Dialogue: 0,0:11:50.77,0:11:53.15,Default,,0,0,0,,Tolong angkat kepalamu, Nona Melida!
Dialogue: 0,0:11:54.19,0:11:59.28,Default,,0,0,0,,Shin, aku juga merasa begitu. Kumencintai dirimu apa adanya.
Dialogue: 0,0:11:59.94,0:12:05.37,Default,,0,0,0,,Habisnya, saat pertama kita bertemu, aku saja tidak tahu kalau kau cucu dari Penyihir hebat.
Dialogue: 0,0:12:08.58,0:12:12.29,Default,,0,0,0,,Pak Cecil, Bu Irene, terima kasih banyak.
Dialogue: 0,0:12:12.79,0:12:14.63,Default,,0,0,0,,Aku akan memenuhi ekspektasi kalian,
Dialogue: 0,0:12:14.63,0:12:16.59,Default,,0,0,0,,dan melindungi Sicily dengan sekuat tenaga.
Dialogue: 0,0:12:17.21,0:12:18.92,Default,,0,0,0,,Ya, kupercayakan padamu.
Dialogue: 0,0:12:19.34,0:12:21.22,Default,,0,0,0,,Mohon bantuannya ya, Shin.
Dialogue: 0,0:12:23.26,0:12:28.51,Default,,0,0,0,,Kakek, terima kasih ya sudah mengurusku. Walau dulu sudah pernah kubilang,
Dialogue: 0,0:12:28.51,0:12:33.52,Default,,0,0,0,,tapi sekali lagi kukatakan, kalau aku sangat bahagia bisa menjadi cucumu.
Dialogue: 0,0:12:35.48,0:12:36.36,Default,,0,0,0,,Shin ....
Dialogue: 0,0:12:37.94,0:12:41.61,Default,,0,0,0,,Nenek, terima kasih juga ya sudah mau jadi Nenekku.
Dialogue: 0,0:12:41.61,0:12:46.45,Default,,0,0,0,,Walau aku selalu dimarahi, tapi aku bahagia telah menjadi cucumu.
Dialogue: 0,0:12:48.20,0:12:50.45,Default,,0,0,0,,Bicara apa sih kau ini?
Dialogue: 0,0:13:03.47,0:13:06.30,Default,,0,0,0,,Ya, semua terlihat cocok memakainya.
Dialogue: 0,0:13:06.84,0:13:11.89,Default,,0,0,0,,Ini ditanam sihir pelindung olehmu kan Wolford?
Dialogue: 0,0:13:12.68,0:13:16.40,Default,,0,0,0,,Selain itu, kutanam sihir optik kamuflase untuk sembunyi,
Dialogue: 0,0:13:16.40,0:13:20.27,Default,,0,0,0,,dan sihir temperatur agar bisa membuatmu tetap berada di suhu yang nyaman.
Dialogue: 0,0:13:20.61,0:13:26.03,Default,,0,0,0,,Jadi artinya, seragam kami yang sudah setingkat harta nasional sekarang ditingkatkan lagi?
Dialogue: 0,0:13:26.03,0:13:26.45,Default,,0,0,0,,Ya.
Dialogue: 0,0:13:26.86,0:13:32.04,Default,,0,0,0,,Wah, akhirnya aku terpaksa pakai seragam yang jadi Rahasia Negara ,...
Dialogue: 0,0:13:32.75,0:13:36.12,Default,,0,0,0,,Oh, omong-omong, sepatunya tidak kutanam sihir ya.
Dialogue: 0,0:13:36.58,0:13:40.42,Default,,0,0,0,,Aku bisa saja tanam sihir udara jet mirip sepatuku, tapi ...
Dialogue: 0,0:13:40.42,0:13:43.17,Default,,0,0,0,,... agak sulit untuk memakai sihirnya.
Dialogue: 0,0:13:43.80,0:13:47.05,Default,,0,0,0,,Dengan seragam ini, serta aksesori yang kita terima sebelumnya,
Dialogue: 0,0:13:47.05,0:13:49.30,Default,,0,0,0,,pertahanan kita jadi sempurna ya?
Dialogue: 0,0:13:49.72,0:13:53.85,Default,,0,0,0,,Yang berarti, latihan hari ini pasti akan cukup berbahaya ya?
Dialogue: 0,0:13:54.39,0:13:56.81,Default,,0,0,0,,Benar.
Dialogue: 0,0:13:57.81,0:14:01.02,Default,,0,0,0,,Kali ini aku ingin kalian latihan bertarung sungguhan.
Dialogue: 0,0:14:02.65,0:14:05.40,Default,,0,0,0,,Kita akan mengalahkan Iblis tingkat bencana.
Dialogue: 0,0:14:05.90,0:14:07.99,Default,,0,0,0,,Tingkat bencana?!
Dialogue: 0,0:14:07.99,0:14:09.53,Default,,0,0,0,,Mana mungkin kami bisa!
Dialogue: 0,0:14:09.82,0:14:14.50,Default,,0,0,0,,Tenang saja! Kalian sudah cukup kuat untuk melakukannya kok.
Dialogue: 0,0:14:15.08,0:14:18.71,Default,,0,0,0,,Lagi pula, seragam kalian sudah ditanam sihir pertahanan terbaik.
Dialogue: 0,0:14:18.71,0:14:20.54,Default,,0,0,0,,Jadi pasti takkan mudah terluka.
Dialogue: 0,0:14:22.21,0:14:25.05,Default,,0,0,0,,Jahat banget kami enggak diajak!
Dialogue: 0,0:14:25.05,0:14:27.55,Default,,0,0,0,,Kenapa kami tidak boleh ikut?!
Dialogue: 0,0:14:28.09,0:14:30.26,Default,,0,0,0,,Hari ini kami lakukan latihan bertarung.
Dialogue: 0,0:14:30.26,0:14:33.10,Default,,0,0,0,,Mana mungkin kami mengajakmu ke tempat berbahaya.
Dialogue: 0,0:14:33.56,0:14:36.68,Default,,0,0,0,,Putri May, tunggu kami saja di kamar.
Dialogue: 0,0:14:36.68,0:14:38.73,Default,,0,0,0,,Tapi ...!
Dialogue: 0,0:14:38.73,0:14:40.35,Default,,0,0,0,,Sudahlah, May.
Dialogue: 0,0:14:40.85,0:14:41.90,Default,,0,0,0,,Oh iya.
Dialogue: 0,0:14:43.02,0:14:44.57,Default,,0,0,0,,Nih, May. Untukmu.
Dialogue: 0,0:14:45.07,0:14:46.82,Default,,0,0,0,,Apa ini?
Dialogue: 0,0:14:48.36,0:14:50.86,Default,,0,0,0,,Ini adalah alat komunikasi sihir jarak jauh.
Dialogue: 0,0:14:51.78,0:14:54.08,Default,,0,0,0,,Kutanam sihir pengiriman dan penerimaan suara.
Dialogue: 0,0:14:55.49,0:14:57.62,Default,,0,0,0,,Cara pakainya seperti ini.
Dialogue: 0,0:14:58.41,0:15:00.54,Default,,0,0,0,,Ayo, May. Cobalah.
Dialogue: 0,0:15:01.92,0:15:05.50,Default,,0,0,0,,Halo? Kau dengar, May?
Dialogue: 0,0:15:06.00,0:15:07.71,Default,,0,0,0,,Iya, aku bisa dengar!
Dialogue: 0,0:15:09.97,0:15:13.01,Default,,0,0,0,,Dia bikin barang luar biasa lagi ya?
Dialogue: 0,0:15:13.01,0:15:16.18,Default,,0,0,0,,Ya, dengan ini mengumpulkan informasi jadi lebih mudah.
Dialogue: 0,0:15:16.60,0:15:20.64,Default,,0,0,0,,May, sampai kami kembali nanti, maukah kau memakai ini?
Dialogue: 0,0:15:21.35,0:15:24.27,Default,,0,0,0,,Ini juga jadi latihan untuk membiasakan diri memakai alat sihir.
Dialogue: 0,0:15:24.65,0:15:25.57,Default,,0,0,0,,Baiklah!
Dialogue: 0,0:15:26.11,0:15:27.32,Default,,0,0,0,,Dasar.
Dialogue: 0,0:15:27.90,0:15:31.57,Default Italic,,0,0,0,,Oh, Nona Melida! Shin menciptakan hal luar biasa!
Dialogue: 0,0:15:31.86,0:15:32.53,Default,,0,0,0,,Gawat!
Dialogue: 0,0:15:32.53,0:15:35.24,Default,,0,0,0,,Kau menciptakan barang aneh lagi ya!
Dialogue: 0,0:15:35.78,0:15:37.83,Default Italic,,0,0,0,,Alat sihir yang mampu mengirimkan suara ...
Dialogue: 0,0:15:37.83,0:15:40.66,Default Italic,,0,0,0,,... adalah impian para pembuat alat sihir tahu!
Dialogue: 0,0:15:41.12,0:15:44.25,Default Italic,,0,0,0,,Tapi tiba-tiba kau malah menciptakan ini dengan mudahnya!
Dialogue: 0,0:15:44.25,0:15:46.46,Default Italic,,0,0,0,,Dan juga, kalau keberadaan benda ini sampai tersebar,
Dialogue: 0,0:15:46.46,0:15:49.59,Default Italic,,0,0,0,,tidak aneh apabila terjadi keributan besar akibat ini!
Dialogue: 0,0:15:50.13,0:15:52.55,Default Italic,,0,0,0,,Kenapa sih kau selalu ....
Dialogue: 0,0:15:53.39,0:15:56.31,Default Italic,,0,0,0,,Hei, Shin! Kau dengar tidak?!
Dialogue: 0,0:15:59.56,0:16:00.73,Default,,0,0,0,,A-Apa ini ....
Dialogue: 0,0:16:01.52,0:16:03.02,Default,,0,0,0,,Kau merasakannya, Sicily?
Dialogue: 0,0:16:03.48,0:16:06.19,Default,,0,0,0,,Iya, ukurannya sangat besar.
Dialogue: 0,0:16:06.48,0:16:07.07,Default,,0,0,0,,Ya.
Dialogue: 0,0:16:07.94,0:16:10.53,Default,,0,0,0,,Reaksi ini, Iblis tingkat bencana.
Dialogue: 0,0:16:11.36,0:16:16.12,Default,,0,0,0,,Berbeda dari harimau yang lincah, Singa memiliki kekuatan besar, tetapi gerakannya lambat.
Dialogue: 0,0:16:16.49,0:16:17.62,Default,,0,0,0,,Jadi artinya?
Dialogue: 0,0:16:18.37,0:16:21.29,Default,,0,0,0,,Memakai serangan sihir jarak jauh?
Dialogue: 0,0:16:21.29,0:16:23.83,Default,,0,0,0,,Benar! Jawaban yang bagus.
Dialogue: 0,0:16:26.17,0:16:28.75,Default,,0,0,0,,Oh, kalau begitu...
Dialogue: 0,0:16:29.09,0:16:29.96,Default,,0,0,0,,Julius,
Dialogue: 0,0:16:30.38,0:16:31.01,Default,,0,0,0,,Yuri,
Dialogue: 0,0:16:31.59,0:16:32.22,Default,,0,0,0,,Mark,
Dialogue: 0,0:16:33.01,0:16:33.72,Default,,0,0,0,,Sicily,
Dialogue: 0,0:16:34.26,0:16:35.05,Default,,0,0,0,,Olivia,
Dialogue: 0,0:16:35.68,0:16:37.14,Default,,0,0,0,,kalian dulu yang pertama.
Dialogue: 0,0:16:37.89,0:16:40.27,Default,,0,0,0,,Mereka semua yang ahli memakai sihir pendukung, 'kan?
Dialogue: 0,0:16:40.85,0:16:42.02,Default,,0,0,0,,Tidak apa-apa memangnya?
Dialogue: 0,0:16:42.68,0:16:45.02,Default,,0,0,0,,Menurutku malah lebih dari cukup.
Dialogue: 0,0:16:48.19,0:16:50.78,Default,,0,0,0,,Tenang saja. Percayalah pada Wolford.
Dialogue: 0,0:16:57.99,0:16:59.24,Default,,0,0,0,,Semua, bersiap!
Dialogue: 0,0:17:05.46,0:17:06.12,Default,,0,0,0,,Tembak!
Dialogue: 0,0:17:27.19,0:17:29.73,Default,,0,0,0,,Sepertinya memang berlebihan ya ....
Dialogue: 0,0:17:31.02,0:17:34.70,Default,,0,0,0,,E-Eh, terus, Iblis Singanya ke mana?
Dialogue: 0,0:17:35.20,0:17:37.78,Default,,0,0,0,,Sudah dikalahkan, tanpa sisa sedikit pun.
Dialogue: 0,0:17:38.24,0:17:41.49,Default,,0,0,0,,Iblis tingkat bencana telah kita habisi?
Dialogue: 0,0:17:41.87,0:17:44.71,Default,,0,0,0,,Anggota spesialis sihir pendukung saja bisa melakukannya.
Dialogue: 0,0:17:45.91,0:17:48.96,Default,,0,0,0,,Kalian berenam yang ahli dalam sihir tipe serangan,
Dialogue: 0,0:17:48.96,0:17:51.00,Default,,0,0,0,,pasti bisa melakukannya sendiri-sendiri.
Dialogue: 0,0:18:13.19,0:18:15.19,Default,,0,0,0,,Lihat, 'kan? Bisa begitu.
Dialogue: 0,0:18:15.19,0:18:19.91,Default,,0,0,0,,Y-Ya, aku sampai ragu telah berhasil mengalahkannya, atau terlalu berlebihan.
Dialogue: 0,0:18:20.78,0:18:23.29,Default,,0,0,0,,Tony nih terutama hebat banget!
Dialogue: 0,0:18:24.33,0:18:27.91,Default,,0,0,0,,Pakai pedang getaran dan langsung menebasnya!
Dialogue: 0,0:18:28.25,0:18:31.59,Default,,0,0,0,,Tapi, sejak kapan kau punya pedang getaran?
Dialogue: 0,0:18:31.96,0:18:37.59,Default,,0,0,0,,Oh? Shin bilang kalau aku mau pakai, akan dipinjamkan.
Dialogue: 0,0:18:37.92,0:18:40.30,Default,,0,0,0,,Curang banget! Aku juga mau!
Dialogue: 0,0:18:40.30,0:18:41.80,Default,,0,0,0,,Minta sama Shin dong.
Dialogue: 0,0:18:42.05,0:18:46.43,Default,,0,0,0,,Bagus, semua sudah berhasil naik level.
Dialogue: 0,0:18:42.39,0:18:44.85,Default Top,,0,0,0,,Tuan Shin!
Dialogue: 0,0:18:48.02,0:18:49.98,Default,,0,0,0,,Selanjutnya giliranmu ya.
Dialogue: 0,0:18:49.98,0:18:51.81,Default,,0,0,0,,Eh? I-Iya ....
Dialogue: 0,0:18:52.52,0:18:57.07,Default,,0,0,0,,Aku tak sabar melihat penampilanmu di pesta pertunangan nanti.
Dialogue: 0,0:19:00.78,0:19:03.99,Default,,0,0,0,,A-Apa memang harus seperti ini ya?
Dialogue: 0,0:19:04.83,0:19:05.91,Default,,0,0,0,,I-Iya?
Dialogue: 0,0:19:19.88,0:19:22.68,Default,,0,0,0,,E-Eh, Shin ...?
Dialogue: 0,0:19:23.22,0:19:25.06,Default,,0,0,0,,Eh? Oh ....
Dialogue: 0,0:19:25.06,0:19:27.81,Default,,0,0,0,,Maaf, kau sangat cantik sampai membuatku terpaku.
Dialogue: 0,0:19:28.23,0:19:34.15,Default,,0,0,0,,Eh? Terima kasih banyak. Shin juga terlihat tampan kok.
Dialogue: 0,0:19:34.15,0:19:35.40,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:19:35.40,0:19:38.94,Default,,0,0,0,,Benar sekali. Apa aku benar terlihat cantik?
Dialogue: 0,0:19:39.28,0:19:42.66,Default,,0,0,0,,Ya, sangat cantik sampai membuatku gugup.
Dialogue: 0,0:19:44.41,0:19:45.62,Default,,0,0,0,,Shin ....
Dialogue: 0,0:19:45.62,0:19:46.58,Default,,0,0,0,,Sicily ....
Dialogue: 0,0:19:51.25,0:19:53.25,Default,,0,0,0,,Aku tahu kok kalian saling mencintai,
Dialogue: 0,0:19:54.17,0:19:56.84,Default,,0,0,0,,tapi jangan terlalu lama untuk muncul di ruang makan ya.
Dialogue: 0,0:20:18.86,0:20:22.11,Default,,0,0,0,,Apa semua sudah memegang gelas?
Dialogue: 0,0:20:22.78,0:20:27.91,Default,,0,0,0,,Shin Wolford, Sicily von Claude,
Dialogue: 0,0:20:28.74,0:20:34.79,Default,,0,0,0,,dengan ini telah kusaksikan dan kurestui pertunangan kalian.
Dialogue: 0,0:20:35.25,0:20:40.51,Default,,0,0,0,,Ini adalah deklarasiku sebagai Raja dari Kerajaan Earlsheid.
Dialogue: 0,0:20:41.21,0:20:45.51,Default,,0,0,0,,Mari bersulang demi awal yang indah bagi kedua anak muda ini.
Dialogue: 0,0:20:46.34,0:20:47.30,Default,,0,0,0,,Bersulang!
Dialogue: 0,0:20:47.51,0:20:49.22,Default,,0,0,0,,Bersulang!
Dialogue: 0,0:22:27.24,0:22:29.66,Default,,0,0,0,,Aduh, selesai juga...
Dialogue: 0,0:22:30.24,0:22:32.20,Default,,0,0,0,,Kerja bagus, Shin.
Dialogue: 0,0:22:32.91,0:22:35.79,Default,,0,0,0,,Tapi, dengan ini situasi sudah tenang ya.
Dialogue: 0,0:22:36.08,0:22:39.29,Default,,0,0,0,,Enggak, masih ada hal penting yang harus dilakukan.
Dialogue: 0,0:22:39.29,0:22:39.87,Default,,0,0,0,,Eh?
Dialogue: 0,0:22:40.29,0:22:41.08,Default,,0,0,0,,Sicily ....
Dialogue: 0,0:22:41.50,0:22:43.21,Default,,0,0,0,,Iya, ada apa?
Dialogue: 0,0:22:44.63,0:22:47.13,Default,,0,0,0,,Maaf kalau urutannya salah.
