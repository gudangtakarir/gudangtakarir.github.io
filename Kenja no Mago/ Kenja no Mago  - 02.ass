Dialogue: 1,0:15:30.07,0:15:30.11,TS,,0,0,0,,{\fs40\fsp5\blur0.7\shad1\clip(1144,546,1232,688)\pos(968,630)}Thor von Flegel
Dialogue: 0,0:15:26.69,0:15:29.44,Default Top,,0,0,0,,Kami adalah pengawas Pangeran.
Dialogue: 0,0:15:30.24,0:15:32.99,TS,,0,0,0,,{\an7\blur1\bord0\fad(500,0)\shad0\fscx100\fscy100\pos(252,600)\p1\c&H36457A&}m -9 -36 l -70 -32 -89 -26 -92 17 -75 33 -17 32 18 32 55 28 74 33 87 20 82 -21 60 -34
Dialogue: 1,0:15:30.24,0:15:32.99,TS,,0,0,0,,{\fs40\fsp-2\fscx70\fad(500,0)\blur0.7\shad1\pos(252,600)}Ruang Menggambar
Dialogue: 0,0:15:30.11,0:15:31.74,Default,,0,0,0,,Kau pulang telat ya.
Dialogue: 0,0:15:31.74,0:15:32.99,Default,,0,0,0,,Apa saja yang kau lakukan?
Dialogue: 0,0:15:32.99,0:15:35.49,Default,,0,0,0,,Maaf, tadi ada kendala.
Dialogue: 0,0:15:35.49,0:15:38.20,Default,,0,0,0,,Oh, biar kuperkenalkan dulu teman-teman sekelasku.
Dialogue: 0,0:15:38.20,0:15:41.67,Default,,0,0,0,,Kalau Aug pasti sudah kenal, di sebelahnya ada Maria dan Sicily.
Dialogue: 0,0:15:41.67,0:15:43.50,Default,,0,0,0,,Lalu sebelahnya lagi ada Thor sama Julius.
Dialogue: 0,0:15:43.92,0:15:45.88,Default,,0,0,0,,Sebuah kehormatan bisa bertemu langsung.
Dialogue: 0,0:15:45.88,0:15:48.80,Default,,0,0,0,,Sa-Sa-Salam kenal! Aku Maria!
Dialogue: 0,0:15:49.67,0:15:51.72,Default,,0,0,0,,Aku Sicily.
Dialogue: 0,0:15:51.72,0:15:53.26,Default,,0,0,0,,Aku Thor.
Dialogue: 0,0:15:53.26,0:15:55.05,Default,,0,0,0,,Namaku Julius.
Dialogue: 0,0:15:57.10,0:16:00.14,Default,,0,0,0,,Oh, terjadi hal seperti itu rupanya?
Dialogue: 0,0:16:00.14,0:16:01.69,Default,,0,0,0,,Oleh karena itu, Nenek,
Dialogue: 0,0:16:01.69,0:16:06.52,Default,,0,0,0,,untuk jaga-jaga, aku ingin menanam ulang sihir di seragam Sicily.
Dialogue: 0,0:16:06.86,0:16:07.86,Default,,0,0,0,,Menanam ulang?!
Dialogue: 0,0:16:07.86,0:16:08.98,Default,,0,0,0,,Apa maksudnya?
Dialogue: 0,0:16:08.98,0:16:12.82,Default,,0,0,0,,Begitu ya, namamu tadi Sicily, 'kan?
Dialogue: 0,0:16:12.82,0:16:14.07,Default,,0,0,0,,I-Iya!
Dialogue: 0,0:16:14.07,0:16:17.41,Default,,0,0,0,,Penanaman ulang sihir ini hal yang penting.
Dialogue: 0,0:16:17.70,0:16:20.45,Default,,0,0,0,,Shin sepertinya menganggap penting keselamatanmu.
Dialogue: 0,0:16:20.45,0:16:24.12,Default,,0,0,0,,Apa kau pikir berhak menerima itu?
Dialogue: 0,0:16:24.12,0:16:26.00,Default,,0,0,0,,Apa aku berhak?
Dialogue: 0,0:16:26.34,0:16:27.84,Default,,0,0,0,,Jangan berlebihan begitu.
Dialogue: 0,0:16:27.84,0:16:29.21,Default,,0,0,0,,Kau diam saja!
Dialogue: 0,0:16:29.59,0:16:34.68,Default,,0,0,0,,Apa kau sadar seragam milikmu sudah kau jadikan apa?
Dialogue: 0,0:16:34.68,0:16:36.05,Default,,0,0,0,,Memang jadi apa?
Dialogue: 0,0:16:36.05,0:16:39.14,Default,,0,0,0,,Itu sudah menjadi alat pelindung tingkat nasional.
Dialogue: 0,0:16:39.51,0:16:41.35,Default,,0,0,0,,Tingkat nasional?!
Dialogue: 0,0:16:41.64,0:16:46.56,Default,,0,0,0,,Aku bahkan tak bisa membayangkan berapa harga yang pantas didapat alat pelindung ini.
Dialogue: 0,0:16:46.90,0:16:49.90,Default,,0,0,0,,Dan dia ingin menanamkan sihir yang sama pada seragam milikmu.
Dialogue: 0,0:16:49.90,0:16:53.61,Default,,0,0,0,,Apa kau siap dan berhak menerimanya?
Dialogue: 0,0:16:53.99,0:16:59.70,Default,,0,0,0,,Soal itu, aku tidak berhak menerimanya.
Dialogue: 0,0:16:59.70,0:17:00.99,Default,,0,0,0,,Eh?
Dialogue: 0,0:17:00.99,0:17:03.54,Default,,0,0,0,,Aku sudah memanfaatkan kebaikan Shin.
Dialogue: 0,0:17:04.00,0:17:08.84,Default,,0,0,0,,Kukira kalau kuberitahu keadaanku dia akan bersimpati lalu menolongku.
Dialogue: 0,0:17:10.07,0:17:14.42,Default,,0,0,0,,Dia ini kuat. Aku bisa paham kalau kau ingin meminta bantuannya.
Dialogue: 0,0:17:14.84,0:17:17.34,Default,,0,0,0,,Sekali pun Shin tidak ada hubungannya denganku,
Dialogue: 0,0:17:17.34,0:17:19.51,Default,,0,0,0,,tapi dia tetap bersedia untuk menolong.
Dialogue: 0,0:17:19.51,0:17:21.22,Default,,0,0,0,,Bahkan sampai bilang ingin melidungiku,
Dialogue: 0,0:17:21.56,0:17:23.48,Default,,0,0,0,,aku sangat bahagia ....
Dialogue: 0,0:17:23.48,0:17:26.10,Default,,0,0,0,,Itu tidak benar! Justru aku yang menyuruhmu ....
Dialogue: 0,0:17:26.10,0:17:29.69,Default,,0,0,0,,Maafkan aku Shin! Sisanya biar aku yang melakukan sesuatu.
Dialogue: 0,0:17:30.19,0:17:33.15,Default,,0,0,0,,Maafkan aku juga karena sudah merepotkanmu, Nyonya Melida.
Dialogue: 0,0:17:33.15,0:17:33.82,Default,,0,0,0,,Sicily!
Dialogue: 0,0:17:33.94,0:17:34.95,Default,,0,0,0,,Tunggu.
Dialogue: 0,0:17:34.95,0:17:38.91,Default,,0,0,0,,Kalau kau langsung menerimanya tanpa bilang apa-apa ...
Dialogue: 0,0:17:39.45,0:17:41.49,Default,,0,0,0,,... aku mungkin akan mengusirmu keluar.
Dialogue: 0,0:17:42.29,0:17:44.87,Default,,0,0,0,,Tapi kau sudah berkata jujur.
Dialogue: 0,0:17:44.87,0:17:48.42,Default,,0,0,0,,Kau menolak kesempatan untuk mendapat alat pelindung tingkat nasional.
Dialogue: 0,0:17:48.71,0:17:51.09,Default,,0,0,0,,Itu bukan hal yang bisa dilakukan oleh siapa pun.
Dialogue: 0,0:17:51.09,0:17:55.13,Default,,0,0,0,,Tapi, aku sudah menipu Shin!
Dialogue: 0,0:17:55.42,0:17:59.14,Default,,0,0,0,,Memang apa salahnya seorang gadis menipu laki-laki?
Dialogue: 0,0:17:59.47,0:18:04.93,Default,,0,0,0,,Apa yang kau lakukan itu sebenarnya imut kok. Lihat saja Shin, dia tak sadar sedikit pun.
Dialogue: 0,0:18:05.27,0:18:09.48,Default,,0,0,0,,Malahan, karena kau bergantung padanya, dia jadi bersemangat.
Dialogue: 0,0:18:09.48,0:18:11.23,Default,,0,0,0,,Iya, aku mengaku.
Dialogue: 0,0:18:12.65,0:18:15.74,Default,,0,0,0,,Sicily, aku tak menganggapmu sudah menipuku.
Dialogue: 0,0:18:15.74,0:18:18.20,Default,,0,0,0,,Aku sendiri yang ingin menolongmu.
Dialogue: 0,0:18:18.57,0:18:21.16,Default,,0,0,0,,Jadi, jangan menolak bantuanku ya?
Dialogue: 0,0:18:21.58,0:18:24.12,Default,,0,0,0,,Kau boleh kalau mau memanfaatkanku.
Dialogue: 0,0:18:24.45,0:18:26.58,Default,,0,0,0,,Shin ....
Dialogue: 0,0:18:26.58,0:18:33.40,Default,,0,0,0,,Maaf ya sudah bersikap keras padamu. Aku harus memastikannya soalnya.
Dialogue: 0,0:18:41.04,0:18:42.51,Default,,0,0,0,,Hei, Shin ....
Dialogue: 0,0:18:42.51,0:18:43.35,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:18:43.35,0:18:48.06,Default,,0,0,0,,Aku tak sadar kalau dia ingin memanfaatkanmu.
Dialogue: 0,0:18:48.06,0:18:49.56,Default,,0,0,0,,Aku juga.
Dialogue: 0,0:18:49.56,0:18:51.90,Default,,0,0,0,,Tapi Melida bisa langsung sadar.
Dialogue: 0,0:18:51.90,0:18:53.98,Default,,0,0,0,,Kalau kau langsung menanam ulang sihirnya,
Dialogue: 0,0:18:53.98,0:18:58.61,Default,,0,0,0,,hati gadis itu pasti akan sedih karena rasa bersalah.
Dialogue: 0,0:18:58.90,0:19:01.41,Default,,0,0,0,,Sihir yang kutanamkan apa sebesar itu dampaknya?
Dialogue: 0,0:19:01.41,0:19:05.20,Default,,0,0,0,,Sulit kupercaya kau tidak sadar. Daripada itu ....
Dialogue: 0,0:19:05.20,0:19:07.95,Default,,0,0,0,,Nenekmu sangat berpengaruh di sini ya?
Dialogue: 0,0:19:07.95,0:19:10.42,Default,,0,0,0,,Aku saja diabaikan seperti figuran.
Dialogue: 0,0:19:10.42,0:19:11.63,Default,,0,0,0,,Yang kuat ya, Kakek.
Dialogue: 0,0:19:11.63,0:19:13.09,TS,,0,0,0,,{\an7\blur1\fad(200,0)\bord0\shad0\fscx100\fscy100\pos(808,180)\p1\c&H38487B&}m -80 -97 l -123 -131 -139 -142 -162 -137 -178 -105 -167 -92 -83 -27 -39 10 17 50 65 88 108 120 137 141 156 140 171 125 177 113 161 86 -5 -46 -45 -72
Dialogue: 1,0:19:11.63,0:19:13.09,TS,,0,0,0,,{\fs52\fsp-2\fad(200,0)\blur0.7\shad1\pos(808,180)\frz322.1}Figuran yang lain
Dialogue: 0,0:19:14.03,0:19:15.38,Default,,0,0,0,,Tapi ya,
Dialogue: 0,0:19:15.92,0:19:18.22,Default,,0,0,0,,aku kagum pada kejujuranmu.
Dialogue: 0,0:19:18.22,0:19:20.76,Default,,0,0,0,,Saat seumuranmu, aku pasti akan diam.
Dialogue: 0,0:19:21.09,0:19:24.85,Default,,0,0,0,,Saat Shin menyelamatkanku, aku benar-benar merasa bahagia.
Dialogue: 0,0:19:25.22,0:19:29.48,Default,,0,0,0,,Tapi karena merasa bersalah, aku jadi tak bisa tinggal diam.
Dialogue: 0,0:19:29.77,0:19:33.46,Default Italic,,0,0,0,,Aku harus menjaganya dengan baik.
Dialogue: 0,0:19:35.97,0:19:37.54,Default,,0,0,0,,Aksaranya menghilang!
Dialogue: 0,0:19:37.54,0:19:38.90,Default,,0,0,0,,Apa kau menghapusnya?
Dialogue: 0,0:19:39.32,0:19:41.95,Default,,0,0,0,,Walau sudah melihatnya, ini memang tidak masuk akal.
Dialogue: 0,0:19:41.95,0:19:44.70,Default,,0,0,0,,Wah, kau sudah berkembang ya.
Dialogue: 0,0:19:45.08,0:19:46.41,Default,,0,0,0,,Selesai.
Dialogue: 0,0:19:46.41,0:19:48.50,Default,,0,0,0,,Kau bisa segalanya ya?
Dialogue: 0,0:19:48.50,0:19:50.62,Default,,0,0,0,,Selama berkaitan sama alat sihir sih.
Dialogue: 0,0:19:50.96,0:19:54.17,Default,,0,0,0,,Untuk mengaktifkannya tetap dibutuhkan energi sihir.
Dialogue: 0,0:19:54.17,0:19:56.67,Default,,0,0,0,,Berarti, kau tetap rentan terhadap serangan dadakan.
Dialogue: 0,0:19:56.67,0:20:00.26,Default,,0,0,0,,Apalagi, yang terlidungi hanyalah wilayah yang tertutup seragam,
Dialogue: 0,0:20:00.26,0:20:02.80,Default,,0,0,0,,jadi lengan, kaki, dan kepala masih bisa terluka.
Dialogue: 0,0:20:02.80,0:20:04.80,Default,,0,0,0,,Ayah, ini 'kan ....
Dialogue: 0,0:20:04.80,0:20:06.72,Default,,0,0,0,,Ya, aku tahu.
Dialogue: 0,0:20:06.72,0:20:08.27,Default,,0,0,0,,Shin, boleh aku bicara?
Dialogue: 0,0:20:08.60,0:20:12.31,Default,,0,0,0,,Penanaman sihir ini luar biasa. Terlalu luar biasa malah.
Dialogue: 0,0:20:12.31,0:20:15.27,Default,,0,0,0,,Kalau dunia sampai tahu, akan terjadi hal yang buruk.
Dialogue: 0,0:20:15.27,0:20:17.44,Default,,0,0,0,,Jadi jangan sampai orang lain tahu akan ini.
Dialogue: 0,0:20:17.44,0:20:18.61,Default,,0,0,0,,Sampai seperti itu?
Dialogue: 0,0:20:18.90,0:20:21.03,Default,,0,0,0,,Kalau pihak militer sampai tahu,
Dialogue: 0,0:20:21.03,0:20:23.49,Default,,0,0,0,,pasti akan ada yang ingin melakukan perang.
Dialogue: 0,0:20:23.86,0:20:25.49,Default,,0,0,0,,Melakukan perang?!
Dialogue: 0,0:20:26.45,0:20:30.37,Default,,0,0,0,,Benar juga. Aku tak berpikir sejauh itu.
Dialogue: 0,0:20:31.29,0:20:34.62,Default,,0,0,0,,Wah, ini pertama kalinya Shin menyesali sesuatu!
Dialogue: 0,0:20:34.62,0:20:35.71,Default,,0,0,0,,Iya!
Dialogue: 0,0:20:35.71,0:20:38.17,Default,,0,0,0,,Yang penting kau mengerti.
Dialogue: 0,0:20:38.17,0:20:42.09,Default,,0,0,0,,Tadinya aku ingin menanamkan sihir yang sama ke seragamnya Aug.
Dialogue: 0,0:20:42.09,0:20:43.30,Default,,0,0,0,,Tapi itu buruk, 'kan?
Dialogue: 0,0:20:43.68,0:20:45.22,Default,,0,0,0,,Aug, maaf ya.
Dialogue: 0,0:20:45.22,0:20:47.60,Default,,0,0,0,,Tu-Tunggu sebentar, Shin!
Dialogue: 0,0:20:47.60,0:20:50.97,Default,,0,0,0,,Selama tidak berlebihan, sepertinya tidak apa-apa deh.
Dialogue: 0,0:20:53.10,0:20:57.06,Default,,0,0,0,,Seragam kalian semua sudah kutanamkan sihir, kau yakin Maria tidak mau?
Dialogue: 0,0:20:57.06,0:21:00.57,Default,,0,0,0,,Aku tak mau memakai alat rahasia nasional begitu.
Dialogue: 0,0:21:00.90,0:21:05.78,Default,,0,0,0,,Terima kasih banyak. Dengan memakai ini rasanya aku seperti dilindungi olehmu, Shin.
Dialogue: 0,0:21:05.78,0:21:07.53,Default,,0,0,0,,Aku sangat senang!
Dialogue: 0,0:21:07.99,0:21:12.00,Default,,0,0,0,,Kalau begitu, Sicily, mulai besok boleh aku mengantarmu sampai ke rumah?
Dialogue: 0,0:21:12.00,0:21:14.71,Default,,0,0,0,,Tapi, bukankah itu akan merepotkanmu?
Dialogue: 0,0:21:14.71,0:21:16.88,Default,,0,0,0,,Tenang saja, kita bisa pakai Gate kok.
Dialogue: 0,0:21:16.88,0:21:17.71,Default,,0,0,0,,Apa itu?
Dialogue: 0,0:21:18.00,0:21:20.21,Default,,0,0,0,,Sihir seperti ini.
Dialogue: 0,0:21:20.21,0:21:21.84,Default,,0,0,0,,Ayo masuk ke dalam.
Dialogue: 0,0:21:22.80,0:21:24.38,Default,,0,0,0,,Di mana ini?!
Dialogue: 0,0:21:24.38,0:21:26.64,Default,,0,0,0,,Rumahku dan Kakek yang dulu.
Dialogue: 0,0:21:26.64,0:21:30.51,Default,,0,0,0,,Tunggu dulu! Kau bilang kalau dulu tinggal di dalam hutan, 'kan?
Dialogue: 0,0:21:30.51,0:21:31.77,Default,,0,0,0,,Di sinilah tempatnya.
Dialogue: 0,0:21:31.77,0:21:33.89,Default,,0,0,0,,Jangan-jangan, tadi itu sihir teleportasi?!
Dialogue: 0,0:21:33.89,0:21:38.86,Default,,0,0,0,,Bukan teleportasi juga sih, tapi lebih ke menghubungkan dua tempat yang berbeda.
Dialogue: 0,0:21:39.19,0:21:41.19,Default,,0,0,0,,Aku tidak paham apa maksudnya.
Dialogue: 0,0:21:42.11,0:21:44.53,Default,,0,0,0,,Gate cuma bisa menghubungkan tempat yang pernah dikunjungi.
Dialogue: 0,0:21:44.53,0:21:47.07,Default,,0,0,0,,Jadi kita baru bisa pakai saat sudah pernah ke rumahmu.
Dialogue: 0,0:21:47.07,0:21:48.41,Default,,0,0,0,,Ba-Baik ....
Dialogue: 0,0:21:48.41,0:21:52.29,Default,,0,0,0,,Duh, ini membuat kepalaku terasa sakit!
Dialogue: 0,0:21:52.29,0:21:56.71,Default,,0,0,0,,Tadinya kukira hanya sikapmu saja yang tidak masuk akal ....
Dialogue: 0,0:21:56.71,0:21:59.04,Default,,0,0,0,,Ternyata sihirnya pun tidak masuk akal.
Dialogue: 0,0:21:59.04,0:22:02.05,Default,,0,0,0,,Murid peringkat satu memang pengetahuan umumnya kurang ya.
Dialogue: 0,0:22:02.05,0:22:04.13,Default,,0,0,0,,Tidak separah itu, 'kan?
Dialogue: 0,0:22:04.13,0:22:05.67,Default,,0,0,0,,Eh?
Dialogue: 0,0:22:05.67,0:22:07.48,Default,,0,0,0,,Eh?
Dialogue: 0,0:22:08.58,0:22:10.05,Default,,0,0,0,,Kenapa bisa ya ....
