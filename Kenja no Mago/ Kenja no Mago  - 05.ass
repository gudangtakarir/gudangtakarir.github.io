Dialogue: 0,0:00:10.39,0:00:15.31,Default,,0,0,0,,Memang deh fitur toilet di sini memang yang terbaik.
Dialogue: 0,0:00:15.31,0:00:17.19,Default,,0,0,0,,Benar-benar modern.
Dialogue: 0,0:00:17.19,0:00:20.82,Default,,0,0,0,,Hei Maria, sini sebentar. Ada yang ingin kutanyakan.
Dialogue: 0,0:00:20.82,0:00:21.74,Default,,0,0,0,,Oh, iya.
Dialogue: 0,0:00:22.03,0:00:24.66,Default,,0,0,0,,Menurutmu bagaimana soal mereka berdua?
Dialogue: 0,0:00:24.66,0:00:28.29,Default,,0,0,0,,Mereka suka terang-terangan bersikap mesra.
Dialogue: 0,0:00:28.29,0:00:31.75,Default,,0,0,0,,Begitu ya? Jadi mereka sudah pacaran?
Dialogue: 0,0:00:32.04,0:00:34.17,Default,,0,0,0,,Kalau itu aku tidak yakin.
Dialogue: 0,0:00:34.17,0:00:37.67,Default,,0,0,0,,Walau sudah pasti sih mereka saling mencintai.
Dialogue: 0,0:00:37.67,0:00:42.13,Default,,0,0,0,,Tapi Sicily masih belum sadar perasaan yang dia rasakan itu rasa cinta.
Dialogue: 0,0:00:42.13,0:00:44.30,Default,,0,0,0,,Kenapa begitu?
Dialogue: 0,0:00:44.30,0:00:47.81,Default,,0,0,0,,Sicily cantik dan sikapnya juga baik.
Dialogue: 0,0:00:47.81,0:00:51.27,Default,,0,0,0,,Dari dulu sudah banyak cowok yang menyatakan cinta padanya,
Dialogue: 0,0:00:51.27,0:00:56.02,Default,,0,0,0,,tapi tidak ada yang dia terima, makanya dia tidak tahu apa perasaannya saat ini.
Dialogue: 0,0:00:56.02,0:00:57.77,Default,,0,0,0,,Berarti ....
Dialogue: 0,0:00:58.32,0:01:01.24,Default,,0,0,0,,Ini adalah cinta pertamanya.
Dialogue: 0,0:02:31.83,0:02:34.91,Default,,0,0,0,,Toko pandai besi Bean masih jauh?
Dialogue: 0,0:02:34.91,0:02:36.50,Default,,0,0,0,,Sebentar lagi sampai kok.
Dialogue: 0,0:02:36.50,0:02:40.92,Default,,0,0,0,,Tapi, sayang Tony tidak bisa ikut.
Dialogue: 0,0:02:43.71,0:02:47.05,Default,,0,0,0,,Ada apa? Dari tadi kau wajahmu murung begitu?
Dialogue: 0,0:02:47.05,0:02:50.64,Default,,0,0,0,,Aug, Schtrom kemungkinan masih hidup.
Dialogue: 0,0:02:50.64,0:02:52.14,Default,,0,0,0,,Bagaimana bisa?
Dialogue: 0,0:02:52.14,0:02:56.10,Default,,0,0,0,,Kau lihat dampak serangan sinar panasku ke tempat latihan prajurit, 'kan?
Dialogue: 0,0:02:56.52,0:03:00.19,Default,,0,0,0,,Aku mencoba hal yang sama di hutan, tapi dampaknya hanya kawah kecil,
Dialogue: 0,0:03:00.19,0:03:02.06,Default,,0,0,0,,bukan ledakan besar.
Dialogue: 0,0:03:02.06,0:03:06.53,Default,,0,0,0,,Ledakan besar waktu itu kemungkinan dibuat untuk mengecoh kita.
Dialogue: 0,0:03:06.99,0:03:08.82,Default,,0,0,0,,Kalau begitu, Schtrom ....
Dialogue: 0,0:03:10.03,0:03:13.66,Default,,0,0,0,,Shin, saat sampai di toko pandai besi, pesan saja semua yang kau butuhkan.
Dialogue: 0,0:03:13.95,0:03:15.29,Default,,0,0,0,,Keluarga Kerajaan yang akan membayarnya.
Dialogue: 0,0:03:16.45,0:03:19.21,Default,,0,0,0,,Setelah mendengar dugaanmu barusan ....
Dialogue: 0,0:03:19.21,0:03:22.42,Default,,0,0,0,,Aku sadar yang bisa melawan Schtrom hanya kau seorang.
Dialogue: 0,0:03:22.42,0:03:24.80,Default,,0,0,0,,Jadi kau harus memiliki persiapan yang matang.
Dialogue: 0,0:03:26.30,0:03:29.18,TS,,0,0,0,,{\an7\fad(400,0)\blur1\bord0\shad0\fscx100\fscy100\pos(234,108)\p1\c&H36467A&}m -94 -26 l -104 -22 -110 -2 -106 18 -80 28 -42 20 -10 29 12 18 34 30 74 28 99 30 112 20 118 6 118 -10 110 -28 -3 -29
Dialogue: 1,0:03:26.30,0:03:29.18,TS,,0,0,0,,{\fs42\fad(400,0)\fsp-2\fscx80\fsp-3\blur0.7\shad1\pos(234,108)}Pandai Besi Bean
Dialogue: 0,0:03:26.67,0:03:29.18,Default,,0,0,0,,Selamat datang di Toko Pandai Besi Bean!
Dialogue: 0,0:03:29.18,0:03:31.09,Default,,0,0,0,,Aku menyambut kalian!
Dialogue: 0,0:03:31.09,0:03:33.76,Default,,0,0,0,,Selamat pagi.
Dialogue: 0,0:03:33.76,0:03:36.68,Default,,0,0,0,,Selamat pagi, Mark, Olivia.
Dialogue: 0,0:03:36.68,0:03:39.64,Default,,0,0,0,,Omong-omong, kenapa pagi begini kalian sudah bareng?
Dialogue: 0,0:03:40.69,0:03:42.77,Default,,0,0,0,,Kalau tidak keberatan ....
Dialogue: 0,0:03:42.77,0:03:45.69,Default,,0,0,0,,Tolong beritahu kami alasannya ....
Dialogue: 0,0:03:45.69,0:03:49.28,Default,,0,0,0,,Tolong ampuni aku!
Dialogue: 0,0:03:49.82,0:03:52.41,Default,,0,0,0,,Ayah! Ayah!
