Dialogue: 0,0:22:13.01,0:22:14.93,OP - Eng,,0,0,0,,{\blur0.5}Di luar akal sehat,
Dialogue: 0,0:22:13.01,0:22:14.93,OP - Rom,,0,0,0,,{\blur2.5}buttobase joushiki wo
Dialogue: 0,0:22:14.93,0:22:17.94,OP - Eng,,0,0,0,,{\fad(0,760)\blur0.5}Ayo kita menuju ke dunia misteri itu
Dialogue: 0,0:22:14.93,0:22:17.94,OP - Rom,,0,0,0,,{\fad(0,760)\blur2.5}michi no sekai e ikou
Dialogue: 0,0:22:27.78,0:22:32.45,OP - Eng,,0,0,0,,{\blur0.5}Buka matamu dan inilah Dunia Baru yang luas itu
Dialogue: 0,0:22:27.78,0:22:32.45,OP - Rom,,0,0,0,,{\blur2.5}me wo aketara hirogaru Brand New World
Dialogue: 0,0:22:32.95,0:22:37.75,OP - Eng,,0,0,0,,{\blur0.5}Baik itu petualangan atau pun tantangan terserah padamu
Dialogue: 0,0:22:32.95,0:22:35.75,OP - Rom,,0,0,0,,{\blur2.5}bouken mo chousen mo
Dialogue: 0,0:22:35.75,0:22:37.75,OP - Rom,,0,0,0,,{\blur2.5}jibun shidai desu
Dialogue: 0,0:22:37.75,0:22:42.59,OP - Eng,,0,0,0,,{\blur0.5}Jika itu adalah dunia warna yang belum pernah kita lihat
Dialogue: 0,0:22:37.75,0:22:42.59,OP - Rom,,0,0,0,,{\blur2.5}mita koto no nai iro no sekai nara
Dialogue: 0,0:22:43.09,0:22:47.72,OP - Eng,,0,0,0,,{\blur0.5}Ayo kita warnai dengan berani dan cerita
Dialogue: 0,0:22:43.09,0:22:45.67,OP - Rom,,0,0,0,,{\blur2.5}daitan ni zanshin ni
Dialogue: 0,0:22:45.67,0:22:47.72,OP - Rom,,0,0,0,,{\blur2.5}nurikaete miyou
Dialogue: 0,0:22:47.72,0:22:47.76,OP - Eng,,0,0,0,,{\blur0.5\clip(593,673,690,697.4)}(Tidak ada) Dibanding tak melakukan sesuatu
Dialogue: 0,0:22:47.76,0:22:50.43,OP - Eng,,0,0,0,,{\blur0.5}(Tidak ada) Dibanding tak melakukan sesuatu
Dialogue: 0,0:22:47.72,0:22:50.43,OP - Rom,,0,0,0,,{\blur2.5}(Nothing)  nanimo shinai yori mo
Dialogue: 0,0:22:50.43,0:22:53.10,OP - Eng,,0,0,0,,{\blur0.5}(Mencoba) Cobalah lakukan hal gila!
Dialogue: 0,0:22:50.43,0:22:53.10,OP - Rom,,0,0,0,,{\blur2.5}(Trying)   nanika yarakashichae!
Dialogue: 0,0:22:53.10,0:22:54.35,OP - Eng,,0,0,0,,{\blur0.5}Bayangkan (Buatlah!)
Dialogue: 0,0:22:53.10,0:22:54.35,OP - Rom,,0,0,0,,{\blur2.5}imeeji wa   (Make it!)
Dialogue: 0,0:22:54.35,0:22:55.68,OP - Eng,,0,0,0,,{\blur0.5}Dengan jelas (Lakukan!)
Dialogue: 0,0:22:54.35,0:22:55.68,OP - Rom,,0,0,0,,{\blur2.5}meikaku ni   (Do it!)
Dialogue: 0,0:22:55.68,0:23:00.02,OP - Eng,,0,0,0,,{\fad(0,500)\blur0.5}Jawabannya berada di dekatmu
Dialogue: 0,0:22:55.68,0:23:00.02,OP - Rom,,0,0,0,,{\fad(0,500)\blur2.5}kotae wa chikaku ni aru
Dialogue: 0,0:23:00.35,0:23:03.27,OP - Eng,,0,0,0,,{\blur0.5}Salahnya di mana jika sihir ini gila
Dialogue: 0,0:23:00.35,0:23:03.27,OP - Rom,,0,0,0,,{\blur2.5}hachamecha na MAGIC de ii janai
Dialogue: 0,0:23:03.27,0:23:07.99,OP - Eng,,0,0,0,,{\blur0.5}Tak masalah bahkan jika tak standar (Apa aku salah lagi?)
Dialogue: 0,0:23:03.27,0:23:07.99,OP - Rom,,0,0,0,,{\blur2.5}kikakugai datte mondai nai sa  (Did I do something wrong?)
Dialogue: 0,0:23:07.99,0:23:10.95,OP - Eng,,0,0,0,,{\blur0.5}Jika berlebihan, minta maaf saja! (Maafkan aku)
Dialogue: 0,0:23:07.99,0:23:10.95,OP - Rom,,0,0,0,,{\blur2.5}yarakashitara torima sorry!   (I’m sorry)
Dialogue: 0,0:23:10.95,0:23:13.16,OP - Eng,,0,0,0,,{\blur0.5}Tidak ada yang salah jika aku serius padamu
Dialogue: 0,0:23:10.95,0:23:13.16,OP - Rom,,0,0,0,,{\blur2.5}kimi ni maji de ii janai
Dialogue: 0,0:23:13.16,0:23:16.79,OP - Eng,,0,0,0,,{\blur0.5}Aku ingin melihat senyummu yang indah (Ya!)
Dialogue: 0,0:23:13.16,0:23:16.79,OP - Rom,,0,0,0,,{\blur2.5}tobikiri no egao ga mitai   (Yes!)
Dialogue: 0,0:23:16.79,0:23:21.50,OP - Eng,,0,0,0,,{\blur0.5}Kau hanya perlu membuat jawabannya benar (selalu begitu)
Dialogue: 0,0:23:16.79,0:23:21.50,OP - Rom,,0,0,0,,{\blur2.5}seikai nante tsukureba ii dake sa   (itsudatte sou)
Dialogue: 0,0:23:21.50,0:23:25.59,OP - Eng,,0,0,0,,{\fad(0,900)\blur0.5}Aku akan menunjukkannya padamu sebuah pengalaman baru
Dialogue: 0,0:23:21.50,0:23:25.59,OP - Rom,,0,0,0,,{\fad(0,890)\blur2.5}kyuukyoku no mitaiken misete ageru zutto
Dialogue: 0,0:23:26.25,0:23:28.72,OP - Rom 2,,0,0,0,karaoke,{\blur2.5}{\k75}Demi {\k41}dirimu {\k46}aku {\k30}memakai {\k30}si{\k30}hir
Dialogue: 0,0:23:28.72,0:23:31.22,OP - Rom 2,,0,0,0,karaoke,{\blur2.5}{\k74}Aku {\k34}se{\k16}lalu {\k50}membutuh{\k30}kan {\k24}sihir{\k30}mu
Dialogue: 0,0:23:31.22,0:23:35.29,OP - Rom 2,,0,0,0,karaoke,{\blur2.5\fad(0,500)}{\k80}Aku {\k42}akan {\k43}selalu {\k40}mengguna{\k37}kan {\k23} sih{\k80}ir
