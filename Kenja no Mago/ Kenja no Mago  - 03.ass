Dialogue: 0,0:00:01.79,0:00:03.01,Default,,0,0,0,,Baiklah,
Dialogue: 0,0:00:03.01,0:00:04.27,Default,,0,0,0,,aku berangkat.
Dialogue: 0,0:00:04.27,0:00:06.71,Default,,0,0,0,,Ya, belajar yang rajin.
Dialogue: 0,0:00:06.71,0:00:07.81,Default,,0,0,0,,Jangan lupa,
Dialogue: 0,0:00:08.80,0:00:11.69,Default,,0,0,0,,kau harus berhati-hati dalam bertindak.
Dialogue: 0,0:00:12.68,0:00:15.35,Default,,0,0,0,,Ya, aku tahu kok, Nek.
Dialogue: 0,0:00:18.68,0:00:22.96,Default Italic,,0,0,0,,Sihir pencarianku tidak menemukan apa pun untuk sekarang.
Dialogue: 0,0:00:22.96,0:00:24.83,Default,,0,0,0,,Maaf ya, Shin.
Dialogue: 0,0:00:24.83,0:00:25.49,Default,,0,0,0,,Eh?
Dialogue: 0,0:00:25.76,0:00:30.52,Default,,0,0,0,,Kau jadi harus jauh-jauh ke rumahku supaya bisa menjemput nanti ....
Dialogue: 0,0:00:30.52,0:00:34.74,Default,,0,0,0,,Jauh-jauh? Kalau pakai Gate tidak terasa ...
Dialogue: 0,0:00:34.74,0:00:39.39,Default,,0,0,0,,... dan juga aku tak bisa membiarkanmu dalam bahaya, 'kan?
Dialogue: 0,0:00:40.79,0:00:42.61,Default,,0,0,0,,Shin ...!
Dialogue: 0,0:00:43.38,0:00:48.22,Default,,0,0,0,,Astaga .... Pagi-pagi sudah mesra-mesraan yang bikin mual.
Dialogue: 0,0:02:22.72,0:02:26.99,Default,,0,0,0,,Selamat pagi, Shin. Pagi-pagi berangkat sekolah bersama dua cewek ...
Dialogue: 0,0:02:26.99,0:02:28.58,Default,,0,0,0,,... kau memang hebat deh.
Dialogue: 0,0:02:28.58,0:02:31.70,Default,,0,0,0,,Berisik, Aug. Kau tahu alasannya juga.
Dialogue: 0,0:02:31.70,0:02:35.21,Default,,0,0,0,,Ya, justru karena tahu aku jadi tak bisa menahan diri.
Dialogue: 0,0:02:35.21,0:02:36.41,Default,,0,0,0,,Kau ini ....
Dialogue: 0,0:02:36.41,0:02:38.61,Default,,0,0,0,,Selamat pagi, tuan Shin.
Dialogue: 0,0:02:38.61,0:02:40.17,Default,,0,0,0,,Selamat pagi.
Dialogue: 0,0:02:40.17,0:02:41.96,Default,,0,0,0,,Pa-Pagi ....
Dialogue: 0,0:02:41.96,0:02:46.76,Default,,0,0,0,,Tepat waktu! Aku masih sempat kan?! Belum telat, 'kan?
Dialogue: 0,0:02:46.76,0:02:48.18,Default,,0,0,0,,I-Iya.
Dialogue: 0,0:02:48.18,0:02:52.85,Default,,0,0,0,,Tepat waktu sih, tapi kenapa hari pertama sekolah datang harus pas sekali.
Dialogue: 0,0:02:52.85,0:02:57.90,Default Top,,0,0,0,,Ya, karena terlalu semangat buat sekolah, aku semalam jadi susah tidur.
Dialogue: 0,0:02:53.60,0:03:00.86,TS,,0,0,0,,{\an7\blur1\fad(400,0)\bord0\shad0\fscx100\fscy100\pos(309.6,593.2)\p1\c&H37467B&}m -129 -32 l -153 -27 -158 -13 -160 11 -146 27 -77 23 -26 29 56 20 99 24 147 16 167 3 168 -12 122 -28 24 -36
Dialogue: 1,0:02:53.60,0:03:00.86,TS,,0,0,0,,{\fs54\fad(400,0)\fscx90\fsp-1\blur0.7\shad1\pos(309.6,593.2)}Alice Corner
Dialogue: 0,0:02:57.90,0:02:59.78,Default Top,,0,0,0,,Terus ketiduran deh.
Dialogue: 0,0:02:59.78,0:03:00.86,Default Top,,0,0,0,,Kau anak kecil apa?!
Dialogue: 0,0:03:00.86,0:03:05.73,Default Italic,,0,0,0,,Eh ... di dunia ini, umur 15 tahun sudah dianggap dewasa ....
Dialogue: 0,0:03:06.28,0:03:08.08,Default,,0,0,0,,Kalian sudah hadir semua?
Dialogue: 0,0:03:08.08,0:03:09.24,Default,,0,0,0,,Pak guru.
Dialogue: 0,0:03:09.24,0:03:11.24,Default,,0,0,0,,Selamat pagi!
Dialogue: 0,0:03:11.24,0:03:15.79,Default,,0,0,0,,Ya, selamat pagi. Ayo duduk, kita mulai bimbingan kelas.
Dialogue: 0,0:03:16.06,0:03:19.21,Default,,0,0,0,,Selesai ini, akan kuantar keliling sekolah.
Dialogue: 0,0:03:21.16,0:03:25.78,Default,,0,0,0,,Sekian tur singkatnya, intinya sih di akademi dibagi dua bangunan besar.
Dialogue: 0,0:03:25.78,0:03:28.01,Default,,0,0,0,,Satu gedung kelas tempat belajar,
Dialogue: 0,0:03:28.42,0:03:31.63,Default,,0,0,0,,gedung lainnya berisi ruang guru, Osis,
Dialogue: 0,0:03:31.63,0:03:35.66,Default,,0,0,0,,serta laboratorium dan ruang tempat kelompok belajar.
Dialogue: 0,0:03:35.66,0:03:39.23,Default Italic,,0,0,0,,Kelompok belajar? Mirip ekskul kali ya?
Dialogue: 0,0:03:39.80,0:03:41.87,Default,,0,0,0,,Kelompok sihir serangan ...,
Dialogue: 0,0:03:43.51,0:03:47.40,Default,,0,0,0,,kelompok sihir keseharian hidup, yang menciptakan alat-alat sihir ...,
Dialogue: 0,0:03:48.14,0:03:52.74,Default,,0,0,0,,ada juga kelompok sihir fisik, yang berfokus pada sihir penguat tubuh.
Dialogue: 0,0:03:52.74,0:03:54.37,Default Italic,,0,0,0,,Yang terakhir itu apaan?
Dialogue: 0,0:03:54.37,0:03:57.12,Default Italic,,0,0,0,,Cara hidupnya sebagai penyihir salah besar?
Dialogue: 0,0:03:57.12,0:03:59.71,Default,,0,0,0,,Kelompok sihir fisik.
Dialogue: 0,0:03:59.71,0:04:02.00,Default,,0,0,0,,Kalau bukan karena tugas menjaga Yang Mulia,
Dialogue: 0,0:04:02.00,0:04:05.84,Default,,0,0,0,,aku pasti sudah bergabung ke sana!
Dialogue: 0,0:04:05.84,0:04:10.67,Default,,0,0,0,,Lah, tidak usah pedulikan aku dan bergabung saja padahal.
Dialogue: 0,0:04:10.67,0:04:14.02,Default,,0,0,0,,Tidak, aku tetap harus mengutamakan tugas.
Dialogue: 0,0:04:15.17,0:04:17.61,Default,,0,0,0,,Di sini adalah Akademi Sihir.
Dialogue: 0,0:04:17.61,0:04:21.10,Default,,0,0,0,,Kuasaku sebagai anggota kerajaan tidak berlaku di sini.
Dialogue: 0,0:04:21.44,0:04:24.61,Default,,0,0,0,,Jadi kau tidak perlu untuk menjagaku setiap saat.
Dialogue: 0,0:04:24.61,0:04:28.53,Default,,0,0,0,,Yang mulia! Aku sangat berterimakasih!
Dialogue: 0,0:04:28.53,0:04:32.78,Default Italic,,0,0,0,,Dia pasti sengaja bilang begitu karena muak di tempel terus-terusan.
Dialogue: 0,0:04:32.78,0:04:36.16,Default,,0,0,0,,Hei, Shin, ada kelompok belajar yang dituju?
Dialogue: 0,0:04:36.16,0:04:37.54,Default,,0,0,0,,Enggak ada sih.
Dialogue: 0,0:04:37.54,0:04:41.61,Default,,0,0,0,,Wajar sih, bagimu pasti tidak ada yang menantang.
Dialogue: 0,0:04:41.61,0:04:43.50,Default,,0,0,0,,Yah, bukan begitu maksudku.
Dialogue: 0,0:04:43.50,0:04:46.54,Default,,0,0,0,,Kalau boleh kasih saran, kenapa tidak buat sendiri saja?
Dialogue: 0,0:04:46.54,0:04:47.55,Default Italic,,0,0,0,,Apa?
Dialogue: 0,0:04:47.55,0:04:52.37,Default,,0,0,0,,Oh, Wolford mau buat kelompok belajar? Aku jadi penasaran.
Dialogue: 0,0:04:52.37,0:04:54.18,Default,,0,0,0,,Itu sudah pasti 'kan, pak guru.
Dialogue: 0,0:04:54.18,0:04:59.44,Default Top,,0,0,0,,Kelompok belajar apa yang akan dibuat Shin serta apa saja kegiatannya, pasti bikin penasaran.
Dialogue: 0,0:04:59.31,0:05:03.39,TS,,0,0,0,,{\an7\blur1\fad(250,0)\bord0\shad0\fscx100\fscy100\pos(796,618)\p1\c&H354377&}m -112 -29 l -131 -21 -135 4 -127 26 -112 28 -70 27 -38 19 12 26 52 24 74 22 101 26 125 26 138 20 137 -2 137 -16 124 -26 29 -32 -56 -25
Dialogue: 1,0:04:59.31,0:05:03.39,TS,,0,0,0,,{\fs46\fad(250,0)\fscx90\fsp-2\blur0.7\shad1\pos(796,618)}Lynn Hughes
Dialogue: 0,0:04:59.44,0:05:01.19,Default Top,,0,0,0,,Memang sih, terdengar menarik.
Dialogue: 0,0:05:01.19,0:05:03.39,Default Top,,0,0,0,,Kalau mau buat, aku ikutan gabung!
Dialogue: 0,0:05:03.39,0:05:06.02,TS,,0,0,0,,{\an7\blur1\bord0\shad0\fscx100\fscy100\pos(986,594)\p1\c&H374579&}m -162 -22 l -170 11 -162 20 -146 23 -117 26 -90 20 -60 28 7 26 36 16 68 26 108 28 134 28 160 20 175 10 170 -14 142 -25 19 -28 -97 -29
Dialogue: 1,0:05:03.39,0:05:06.02,TS,,0,0,0,,{\fs56\fscx90\fsp-2\blur0.7\shad1\pos(986,594)}Yuri Carlton
Dialogue: 0,0:05:03.39,0:05:06.02,Default Top,,0,0,0,,Aku juga akan ikut sepertinya.
Dialogue: 0,0:05:06.02,0:05:10.61,TS,,0,0,0,,{\an7\blur1\bord0\shad0\fscx100\fscy100\pos(274,106)\p1\c&H37457A&}m -139 -28 l -147 -19 -148 13 -136 22 -96 23 -86 20 -61 23 -41 11 -4 19 21 26 38 20 73 24 89 16 108 22 131 23 148 16 155 7 156 -4 154 -12 148 -21 130 -28 54 -26 -57 -24
Dialogue: 1,0:05:06.02,0:05:10.61,TS,,0,0,0,,{\fs48\fscx90\blur0.7\shad1\pos(274,106)}Tony Freyd
Dialogue: 0,0:05:06.02,0:05:10.61,Default,,0,0,0,,Benar juga, kalau aku bergabung ke sana pasti bakal bisa terus bertahan di kelas S.
Dialogue: 0,0:05:10.61,0:05:14.28,Default,,0,0,0,,Pak guru, apa saja syarat membuat kelompok belajar?
Dialogue: 0,0:05:14.28,0:05:17.04,Default,,0,0,0,,Minimal harus ada lima anggota dan guru pembimbing.
Dialogue: 0,0:05:17.04,0:05:21.02,Default,,0,0,0,,Sisanya hanya tinggal perlu menyerahkan formulir kok.
Dialogue: 0,0:05:21.02,0:05:24.00,Default,,0,0,0,,Kalau mau buat, biar bapak yang jadi guru pembimbingnya.
Dialogue: 0,0:05:25.36,0:05:27.88,Default,,0,0,0,,Hei semua, tunggu sebentar!
Dialogue: 0,0:05:27.88,0:05:32.51,Default,,0,0,0,,Kalau Shin mau buat kelompok belajar, sudah pasti aku harus ikut bergabung.
Dialogue: 0,0:05:32.51,0:05:33.51,Default,,0,0,0,,Eh?
Dialogue: 0,0:05:33.51,0:05:38.85,Default,,0,0,0,,Habisnya 'kan, kau akan mengantarnya pulang kan, jadi wajar beraktivitas bersama.
Dialogue: 0,0:05:38.85,0:05:41.64,Default,,0,0,0,,Ya, ada benarnya juga sih ....
Dialogue: 0,0:05:41.64,0:05:45.94,Default,,0,0,0,,Kalau kau jadi ketua kelompok belajar, apa saja kegiatannya?
Dialogue: 0,0:05:45.94,0:05:47.86,Default,,0,0,0,,Aku belum bilang "mau" loh!
Dialogue: 0,0:05:47.86,0:05:50.24,Default,,0,0,0,,Bagaimana kalau Kelompok Belajar Pahlawan?
Dialogue: 0,0:05:50.24,0:05:51.82,Default,,0,0,0,,Eh? Apaan itu maksudnya?
Dialogue: 0,0:05:51.82,0:05:55.95,Default,,0,0,0,,Shin harus menceritakan segala hal tentang tuan Merlin dan nyonya Melida!
Dialogue: 0,0:05:55.95,0:05:57.20,Default Italic,,0,0,0,,Eh?!
Dialogue: 0,0:05:57.47,0:06:02.54,Default,,0,0,0,,Sayangnya, sudah ada kelompok belajar yang berfokus pada Pria Bjiak dan Nyonya Cakap.
Dialogue: 0,0:06:02.54,0:06:03.58,Default Italic,,0,0,0,,Sudah ada?!
Dialogue: 0,0:06:03.58,0:06:04.62,Default,,0,0,0,,Kalau begitu,
Dialogue: 0,0:06:04.62,0:06:08.46,Default,,0,0,0,,bagaimana kalau buat kegiatan menguasai segala macam sihir dan Wolford menjadi panutannya?
Dialogue: 0,0:06:08.46,0:06:09.67,Default,,0,0,0,,Apa?!
Dialogue: 0,0:06:09.67,0:06:13.67,Default Top,,0,0,0,,Namanya, Kelompok Kulminasi Penelitian Sihir.
Dialogue: 0,0:06:11.17,0:06:13.67,TS,,0,0,0,,{\c&H000000&\fs70\blur0.7\fnAriendezze\pos(640,456)}Kelompok Kulminasi Penelitian Sihir
Dialogue: 0,0:06:13.71,0:06:15.76,TS,,0,0,0,,{\c&H000000&\fs90\shad4\blur0.7\fnAriendezze\4c&HF6F4F2&\move(1884,444,-598,444,100,1950)}Kelompok Kulminasi Penelitian Sihir
Dialogue: 0,0:06:13.67,0:06:17.01,Default Italic,,0,0,0,,Memalukan! Lebay banget sih namanya, Lynn!
Dialogue: 0,0:06:17.01,0:06:22.26,Default,,0,0,0,,Oh, Kulminasi Penelitian Sihir ya .... Terdengar cocok denganmu, Shin.
Dialogue: 0,0:06:22.26,0:06:23.52,Default,,0,0,0,,Eh?
Dialogue: 0,0:06:23.52,0:06:27.40,Default,,0,0,0,,Bagus! Kulminasi penelitian sihir! Terdengar hebat sekali!
Dialogue: 0,0:06:27.40,0:06:29.23,Default,,0,0,0,,Enggak-enggak! Tunggu dulu, sebentar!
Dialogue: 0,0:06:29.23,0:06:31.95,Default,,0,0,0,,Buat materi kegiatannya, serahkan saja padaku.
Dialogue: 0,0:06:31.95,0:06:33.06,Default,,0,0,0,,Eh?!
Dialogue: 0,0:06:33.06,0:06:35.03,Default,,0,0,0,,Yang mau bergabung, angkat tangan.
Dialogue: 0,0:06:35.03,0:06:36.41,Default,,0,0,0,,Aku!
Dialogue: 0,0:06:36.41,0:06:39.59,Default,,0,0,0,,Jangan pakai kulminasi dong ....
Dialogue: 0,0:06:42.40,0:06:47.29,Default,,0,0,0,,Setahun belakangan ini, kemunculan Iblis semakin meningkat drastis?
Dialogue: 0,0:06:47.29,0:06:50.55,Default,,0,0,0,,Kenapa? Kalau jumlah mereka meningkat,
Dialogue: 0,0:06:50.55,0:06:53.16,Default,,0,0,0,,harusnya terjadi lebih banyak keributan di kerajaan.
Dialogue: 0,0:06:53.16,0:06:57.39,Default,,0,0,0,,Tetapi, aku tak pernah dengar apa pun soal ini.
Dialogue: 0,0:06:58.00,0:07:00.55,Default,,0,0,0,,Apa maksudnya semua ini, Dominic?
Dialogue: 0,0:07:00.55,0:07:07.94,TS,,0,0,0,,{\an7\blur1\bord0\shad0\fscx100\fscy100\pos(296,100)\p1\c&H354478&}m -174 -25 l -174 6 -173 17 -165 20 -109 22 -88 18 -55 22 -18 15 30 21 55 18 78 22 121 13 150 21 179 17 184 -2 173 -15 152 -23 55 -30 -76 -26
Dialogue: 1,0:07:00.55,0:07:07.94,TS,,0,0,0,,{\fs48\fscx90\blur0.7\shad1\pos(296,100)}Dominic Gastor
Dialogue: 0,0:07:00.55,0:07:04.27,Default,,0,0,0,,Dengan melihat laporan harian, harusnya sudah jelas.
Dialogue: 0,0:07:04.27,0:07:07.94,Default,,0,0,0,,Jumlah Iblis yang muncul meningkat sedikit demi sedikit.
Dialogue: 0,0:07:07.94,0:07:10.94,Default,,0,0,0,,Walau jumlah tepatnya belum bisa dipastikan,
Dialogue: 0,0:07:10.94,0:07:13.59,Default,,0,0,0,,tapi memang terus bertambah jumlahnya.
Dialogue: 0,0:07:14.53,0:07:18.21,Default,,0,0,0,,Jumlah peningkatannya sangat sedikit sampai tidak mencolok.
Dialogue: 0,0:07:18.21,0:07:21.75,Default,,0,0,0,,Ini hanyalah pendapat pribadiku, tetapi ...
Dialogue: 0,0:07:21.75,0:07:24.12,Default,,0,0,0,,... mungkin ini perbuatan yang disengaja.
Dialogue: 0,0:07:24.69,0:07:28.33,Default,,0,0,0,,Omong kosong! Mana mungkin peningkatan jumlah Iblis ini disengaja?!
Dialogue: 0,0:07:28.33,0:07:31.05,Default,,0,0,0,,Yang Mulia, situasi ini sangat tidak biasa.
Dialogue: 0,0:07:31.05,0:07:33.80,Default,,0,0,0,,Kita harus segera menyelidikinya.
Dialogue: 0,0:07:33.80,0:07:35.38,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:07:35.91,0:07:40.63,Default,,0,0,0,,Perintahkan Kelompok Pemburu Iblis untuk menyelidiki hal ini!
Dialogue: 0,0:07:41.13,0:07:42.25,Default,,0,0,0,,Baik.
Dialogue: 0,0:07:43.64,0:07:46.06,TS,,0,0,0,,{\an7\blur1\fad(500,0)\bord0\shad0\fscx100\fscy100\pos(248,96)\p1\c&H344377&}m -69 -19 l -92 -24 -117 -19 -120 -8 -120 8 -115 21 -105 24 -70 24 -60 20 -40 26 -4 22 31 23 68 24 96 25 113 26 124 16 125 5 125 -8 119 -20 110 -24 -15 -25
Dialogue: 1,0:07:43.64,0:07:46.06,TS,,0,0,0,,{\fs40\fscx75\fad(500,0)\blur0.7\fsp-2\shad1\pos(248,96)}Kediaman Rietsburg
Dialogue: 0,0:07:44.63,0:07:46.06,Default,,0,0,0,,Kurt!
Dialogue: 0,0:07:46.06,0:07:47.98,Default,,0,0,0,,Kurt di mana kau?!
Dialogue: 0,0:07:49.47,0:07:51.43,Default,,0,0,0,,Ada apa, Ayah?
Dialogue: 0,0:07:52.32,0:07:56.53,Default,,0,0,0,,Kau tanya ada apa?! Yang Mulia barusan memanggilku.
Dialogue: 0,0:07:56.53,0:07:58.86,Default,,0,0,0,,Kau tahu alasannya kenapa, 'kan?
Dialogue: 0,0:08:00.36,0:08:03.37,Default,,0,0,0,,Berengsek, apa yang kau pikirkan?!
Dialogue: 0,0:08:03.37,0:08:08.20,Default,,0,0,0,,Kau tahu kalau menyalahgunakan kekuasaan di Akademi Sihir itu dilarang, 'kan?!
Dialogue: 0,0:08:08.20,0:08:11.92,Default,,0,0,0,,Dengan segala hormat, Ayah, kita ini adalah orang-orang pilihan.
Dialogue: 0,0:08:11.92,0:08:15.63,Default,,0,0,0,,Tidak sepatutnya kita diperlakukan sama layaknya rakyat jelata!
Dialogue: 0,0:08:15.63,0:08:19.89,Default,,0,0,0,,Kurt, kau .... Kau ini bicara apa?
Dialogue: 0,0:08:19.89,0:08:22.22,Default,,0,0,0,,Aku adalah orang terpilih!
Dialogue: 0,0:08:22.22,0:08:24.35,Default,,0,0,0,,Aku manusia yang spesial!
Dialogue: 0,0:08:24.35,0:08:27.31,Default,,0,0,0,,Tetapi semua menentang dan melawanku!
Dialogue: 0,0:08:27.31,0:08:31.10,Default,,0,0,0,,Mana mungkin aku bisa terima begitu saja!
Dialogue: 0,0:08:32.59,0:08:36.78,Default,,0,0,0,,Ya, karena dia, semenjak dia muncul semua jadi berantakan.
Dialogue: 0,0:08:36.78,0:08:38.95,Default,,0,0,0,,Aku tak bisa seenaknya terhadap perempuanku,
Dialogue: 0,0:08:38.95,0:08:43.28,Default,,0,0,0,,apalagi, Yang Mulia juga sudah jelas memihaknya, jadi ....
Dialogue: 0,0:08:43.28,0:08:45.53,Default,,0,0,0,,Kurt!
Dialogue: 0,0:08:47.49,0:08:50.54,Default,,0,0,0,,Aku tak bisa mengabaikan ucapanmu itu!
Dialogue: 0,0:08:50.54,0:08:52.71,Default,,0,0,0,,Kau harus mendapat hukuman!
Dialogue: 0,0:08:53.17,0:08:56.44,Default,,0,0,0,,Siapa pun, cepat kurung Kurt di kamarnya!
Dialogue: 0,0:09:01.45,0:09:04.99,Default,,0,0,0,,Apa yang terjadi padamu, Kurt?
Dialogue: 0,0:09:08.51,0:09:10.52,TS,,0,0,0,,{\an7\blur1\bord0\shad0\fscx100\fscy100\pos(1070.667,96)\p1\c&H39497E&}m -52 -24 l -77 -24 -87 -24 -92 -13 -92 5 -91 19 -86 24 -70 21 -45 22 -12 22 -4 -5 11 19 21 25 33 22 57 22 70 25 84 22 89 12 86 0 86 -15 83 -21 66 -26 37 -27 12 -23 -3 -13 -22 -23
Dialogue: 1,0:09:08.51,0:09:10.52,TS,,0,0,0,,{\fs36\fscx70\fsp-3\blur0.7\shad1\pos(1070.667,96)}Esoknya{\fscx30} {\fscx70}di{\fscx30} {\fscx70}Akademi
Dialogue: 0,0:09:10.52,0:09:12.88,Default,,0,0,0,,Kurt mendapat hukuman?
Dialogue: 0,0:09:12.88,0:09:17.53,Default,,0,0,0,,Ya, tadi pagi kediaman Rietsburg menghubungi pihak sekolah.
Dialogue: 0,0:09:17.53,0:09:18.69,Default,,0,0,0,,Hei,
Dialogue: 0,0:09:18.69,0:09:22.92,Default,,0,0,0,,kalau boleh tanya, kenapa Kurt bersikap seperti itu?
Dialogue: 0,0:09:22.92,0:09:26.59,Default,,0,0,0,,Dia tidak boleh menyalah gunakan statusnya begitu saja, 'kan?
Dialogue: 0,0:09:27.19,0:09:30.21,Default,,0,0,0,,Jujur, kami sendiri juga bingung.
Dialogue: 0,0:09:30.21,0:09:33.34,Default,,0,0,0,,Kami berdua satu SMP dengannya,
Dialogue: 0,0:09:33.34,0:09:36.13,Default,,0,0,0,,tapi perilakunya tidak pernah seperti ini.
Dialogue: 0,0:09:36.13,0:09:40.55,Default,,0,0,0,,Dia memang agak sombong, tapi sikapnya tak pernah kelewatan.
Dialogue: 0,0:09:40.55,0:09:46.05,Default,,0,0,0,,Kalau ada yang aneh, dia berubah begitu sesaat setelah pergi ke laboratorium pak guru Schtrom.
Dialogue: 0,0:09:46.05,0:09:48.28,Default,,0,0,0,,Oh iya kau benar ....
Dialogue: 0,0:09:48.28,0:09:49.76,Default,,0,0,0,,Schtrom?
Dialogue: 0,0:09:49.76,0:09:51.98,Default,,0,0,0,,Di saat kami kelas tiga SMP,
Dialogue: 0,0:09:51.98,0:09:57.40,Default,,0,0,0,,dia pindah kemari sebagai guru Sihir dengan alasan sudah diasingkan dari Kekaisarannya.
Dialogue: 0,0:09:57.40,0:10:03.99,Default,,0,0,0,,Dia meminta siapa pun yang kurang ahli dalam Sihir untuk datang ke laboratoriumnya.
Dialogue: 0,0:10:03.99,0:10:06.95,Default,,0,0,0,,Karena mencurigakan, kami pun menolaknya.
Dialogue: 0,0:10:06.95,0:10:10.74,Default,,0,0,0,,Sepertinya dia mengalami kebutaan, karena kedua matanya ditutup, tapi ...
Dialogue: 0,0:10:10.74,0:10:13.03,Default,,0,0,0,,... dia bisa bersikap secara normal.
Dialogue: 0,0:10:13.03,0:10:18.21,Default,,0,0,0,,Mungkin dia memakai semacam sihir khusus yang bisa membedakan objek tanpa energi sihir.
Dialogue: 0,0:10:18.21,0:10:23.25,Default,,0,0,0,,Penyihir memakai penutup mata yang diasingkan dari Kekaisaran?
Dialogue: 0,0:10:24.34,0:10:28.68,TS,,0,0,0,,{\an7\blur1\bord0\shad0\fad(500,0)\fscx100\fscy100\pos(354.667,102)\p1\c&H38487C&}m -164 -22 l -222 -20 -228 -11 -227 7 -216 26 -198 18 -182 27 -166 18 -146 28 -135 18 -121 26 -113 14 -99 26 -81 14 -60 26 -44 25 -35 18 -27 26 0 26 13 16 17 0 26 2 31 18 35 23 45 25 58 25 90 25 114 26 132 24 143 23 161 14 181 22 198 24 215 20 221 13 220 2 218 -10 197 -20 102 -25 57 -24 37 -22 24 -4 7 -22 -67 -28
Dialogue: 1,0:10:24.34,0:10:28.68,TS,,0,0,0,,{\fs42\fscx90\fad(500,0)\fsp-1\blur0.7\shad1\pos(354.667,102)}Aula Kediaman Rietsburg
Dialogue: 0,0:10:24.95,0:10:28.67,Default,,0,0,0,,Oh, pak Schtrom, syukurlah kau bisa datang!
Dialogue: 0,0:10:28.67,0:10:31.86,Default,,0,0,0,,Lama tak jumpa, Nyonya Rietsburg.
Dialogue: 0,0:10:31.86,0:10:33.97,Default,,0,0,0,,Bagaimana keadaan anakmu?
Dialogue: 0,0:10:33.97,0:10:38.19,Default,,0,0,0,,Duh, aku sudah tidak tahu lagi harus bagaimana!
Dialogue: 0,0:10:38.19,0:10:41.43,Default,,0,0,0,,Bagaimana bisa anakku menjadi seperti itu?
Dialogue: 0,0:10:41.43,0:10:44.80,Default,,0,0,0,,Suamiku berusaha untuk mendisiplinkannya.
Dialogue: 0,0:10:44.80,0:10:47.31,Default,,0,0,0,,Kalau begini, anakku bisa-bisa ....
Dialogue: 0,0:10:47.31,0:10:52.40,Default,,0,0,0,,Jadi begitu. Dia sudah menganggapku sebagai gurunya.
Dialogue: 0,0:10:52.40,0:10:54.54,Default,,0,0,0,,Jadi mungkin aku bisa bicara dengannya.
Dialogue: 0,0:10:54.54,0:10:58.09,Default,,0,0,0,,Kumohon. Hanya bapak yang bisa membantunya.
Dialogue: 0,0:10:58.09,0:11:00.81,Default,,0,0,0,,Tolong buat dia kembali seperti semula!
Dialogue: 0,0:11:07.00,0:11:08.91,Default,,0,0,0,,Ada apa, Kurt?
Dialogue: 0,0:11:10.14,0:11:12.64,Default,,0,0,0,,Pak Schtrom?
Dialogue: 0,0:11:13.79,0:11:17.73,Default,,0,0,0,,Ini benar-benar pemandangan yang menyedihkan.
Dialogue: 0,0:11:21.59,0:11:25.78,Default,,0,0,0,,Aku sudah bilang 'kan, kalau kau adalah orang yang spesial.
Dialogue: 0,0:11:25.78,0:11:26.94,Default,,0,0,0,,Iya.
Dialogue: 0,0:11:26.94,0:11:30.55,Default,,0,0,0,,Kedudukan serta kemampuanmu itu spesial.
Dialogue: 0,0:11:30.55,0:11:33.41,Default,,0,0,0,,Tak ada hal yang tidak bisa kau dapatkan.
Dialogue: 0,0:11:33.41,0:11:36.79,Default,,0,0,0,,Tetapi, aku gagal mendapat gadis itu!
Dialogue: 0,0:11:36.79,0:11:40.12,Default,,0,0,0,,Karena dia .... Dia sudah menghalangiku!
Dialogue: 0,0:11:40.12,0:11:46.21,Default,,0,0,0,,Oh begitu. Bagimu dia adalah sebuah penghalang ya?
Dialogue: 0,0:11:48.22,0:11:52.97,Default,,0,0,0,,Dengar ya. Kau harus memberikan pelajaran pada si penghalang ini.
Dialogue: 0,0:11:53.31,0:11:56.50,Default,,0,0,0,,Kau manusia terpilih soalnya.
Dialogue: 0,0:12:06.14,0:12:07.99,Default,,0,0,0,,Kurt,
Dialogue: 0,0:12:07.99,0:12:11.36,Default,,0,0,0,,menarilah sebaik mungkin untukku.
Dialogue: 0,0:12:19.71,0:12:22.42,TS,,0,0,0,,{\an7\blur1\bord0\shad0\fscx100\fscy100\pos(206.667,100)\p1\c&H344174&}m -68 -26 l -79 -23 -84 -9 -84 7 -78 18 -69 23 -45 17 -34 23 -14 25 6 25 19 24 33 22 49 22 56 22 69 23 78 23 85 17 86 1 80 -16 71 -25
Dialogue: 1,0:12:19.71,0:12:22.42,TS,,0,0,0,,{\fs38\fscx75\fsp-3\blur0.7\shad1\pos(206.667,100)}Kantin Sekolah
Dialogue: 0,0:12:22.42,0:12:26.34,Default,,0,0,0,,Shin, mulai sekarang bagaimana dengan kegiatan berangkat dan pulang sekolahmu?
Dialogue: 0,0:12:26.34,0:12:28.09,Default,,0,0,0,,Bagaimana apanya?
Dialogue: 0,0:12:28.09,0:12:30.72,Default,,0,0,0,,Kurt sedang dihukum di rumah.
Dialogue: 0,0:12:30.72,0:12:33.79,Default,,0,0,0,,Jadi bahaya sudah tidak ada lagi, 'kan?
Dialogue: 0,0:12:33.79,0:12:35.72,Default,,0,0,0,,Ya, benar juga sih.
Dialogue: 0,0:12:35.72,0:12:38.30,Default,,0,0,0,,Mungkin aku tak perlu mengantar lagi.
Dialogue: 0,0:12:39.55,0:12:44.48,Default,,0,0,0,,Benar juga .... Dia hanya mengantarku ....
Dialogue: 0,0:12:44.48,0:12:48.92,Default,,0,0,0,,Tapi, tidak ada salahnya dia ke sekolah bersamaku tanpa alasan khusus, 'kan?
Dialogue: 0,0:12:48.92,0:12:50.99,Default,,0,0,0,,Rumah kami juga kebetulan searah.
Dialogue: 0,0:12:50.99,0:12:52.92,Default,,0,0,0,,Tidak ada salahnya!
Dialogue: 0,0:12:53.36,0:12:57.16,Default,,0,0,0,,Be-Benar juga! Rumah kita searah ya!
Dialogue: 0,0:12:57.16,0:13:00.37,Default,,0,0,0,,Jadi tidak aneh kalau kita sering berangkat dan pulang sekolah bareng!
Dialogue: 0,0:13:01.86,0:13:04.58,Default,,0,0,0,,Oh! Maaf ....
Dialogue: 0,0:13:04.58,0:13:07.47,Default,,0,0,0,,Duh, Sicily terlalu semangat deh.
Dialogue: 0,0:13:07.47,0:13:08.84,Default,,0,0,0,,Bu-Bukan!
Dialogue: 0,0:13:08.84,0:13:10.58,Default,,0,0,0,,Kau memang hebat, Shin.
Dialogue: 0,0:13:10.58,0:13:11.22,Default,,0,0,0,,Eh?
Dialogue: 0,0:13:11.22,0:13:14.06,Default,,0,0,0,,Di depan semua orang bilang "bersamaku" tanpa malu.
Dialogue: 0,0:13:14.06,0:13:16.80,Default,,0,0,0,,Aku sih tidak akan bisa bilang begitu.
Dialogue: 0,0:13:17.22,0:13:19.87,Default,,0,0,0,,Memang aku bilang begitu ya?
Dialogue: 0,0:13:21.55,0:13:26.36,Default,,0,0,0,,Ya, bercandanya kita kesampingkan dulu, tapi berangkat sekolah bersama itu hal bagus kok.
Dialogue: 0,0:13:26.36,0:13:30.51,Default,,0,0,0,,Claude dan Messina adalah gadis yang cantik.
Dialogue: 0,0:13:30.51,0:13:33.45,Default,,0,0,0,,Jadi pasti bakal menarik perhatian yang tidak perlu.
Dialogue: 0,0:13:33.45,0:13:37.20,Default,,0,0,0,,Ya, kalau itu terjadi, sihir pencarianku pasti akan mendeteksinya.
Dialogue: 0,0:13:37.20,0:13:38.58,Default,,0,0,0,,Eh? Kok bisa?
Dialogue: 0,0:13:38.58,0:13:42.58,Default,,0,0,0,,Kok bisa? Biasanya kau pasti sadar kalau ada yang berniat buruk terhadapmu, 'kan?
Dialogue: 0,0:13:42.58,0:13:46.05,Default,,0,0,0,,Mana bisa mendeteksi niat jahat pakai sihir pencari!
Dialogue: 0,0:13:46.05,0:13:49.84,Default,,0,0,0,,Eh, Thor .... Sudah pernah berburu Iblis?
Dialogue: 0,0:13:49.84,0:13:55.34,Default,,0,0,0,,Jelas belumlah, aku juga baru lulus SMP kali.
Dialogue: 0,0:13:55.34,0:14:01.71,Default,,0,0,0,,Energi sihir milik Iblis itu terasa sangat buruk dan menjijikkan, pokoknya tidak biasa deh.
Dialogue: 0,0:14:01.71,0:14:05.94,Default,,0,0,0,,Manusia biasa juga memiliki sensasi semacam itu, jadi bisa dibedakan.
Dialogue: 0,0:14:05.94,0:14:07.61,Default,,0,0,0,,Berarti kau jangan-jangan ....
Dialogue: 0,0:14:07.61,0:14:10.57,Default,,0,0,0,,Wolford sudah pernah berburu Iblis ya?
Dialogue: 0,0:14:10.57,0:14:11.60,Default,,0,0,0,,Pernah.
Dialogue: 0,0:14:12.28,0:14:15.37,Default,,0,0,0,,Omong-omong, berapa umurmu saat melakukan itu?
Dialogue: 0,0:14:15.37,0:14:16.32,Default,,0,0,0,,Sepuluh tahun.
Dialogue: 0,0:14:16.32,0:14:17.91,Default,,0,0,0,,Sepuluh tahun!?
Dialogue: 0,0:14:17.91,0:14:19.95,Default,,0,0,0,,Kalau tak salah, beruang bentuknya.
Dialogue: 0,0:14:19.95,0:14:21.63,Default,,0,0,0,,Beruang?!
Dialogue: 0,0:14:22.08,0:14:26.42,Default,,0,0,0,,Tingginya tiga meter, aku sampai harus menebas kepalanya.
Dialogue: 0,0:14:27.66,0:14:29.54,Default,,0,0,0,,E-Eh?
Dialogue: 0,0:14:29.54,0:14:33.42,TS,,0,0,0,,{\c&H242221&\fs70\blur0.8\fnBubblegum Sans\pos(918,50)}Aku salah lagi ya?
Dialogue: 0,0:14:29.99,0:14:33.42,Default Italic,,0,0,0,,Aku salah lagi ya?
Dialogue: 0,0:14:33.42,0:14:36.98,Default,,0,0,0,,Eh? Bagian mana memang yang bikin kalian terkejut?
Dialogue: 0,0:14:36.98,0:14:39.74,Default,,0,0,0,,Semuanya.
Dialogue: 0,0:14:40.71,0:14:44.13,Default,,0,0,0,,Siang nanti ada orientasi Kelompok Belajar ya ....
Dialogue: 0,0:14:44.13,0:14:49.82,Default,,0,0,0,,Padahal kami sudah memutuskan bergabung di Kelompok Kulminasi Penelitian Sihir juga.
Dialogue: 0,0:14:49.82,0:14:54.86,Default,,0,0,0,,Percuma juga mendengarkan mereka bicara soal Kelompok Belajar yang tidak kita minati.
Dialogue: 0,0:14:54.86,0:15:00.41,Default,,0,0,0,,Jangan bilang begitu. Kalau tidak ikut datang, pasti bakal jadi pembicaraan buruk.
Dialogue: 0,0:15:02.28,0:15:04.45,Default Italic,,0,0,0,,Ada niat jahat mengarah kemari.
Dialogue: 0,0:15:06.15,0:15:07.42,Default Italic,,0,0,0,,Dari mana?!
Dialogue: 0,0:15:13.09,0:15:13.84,Default,,0,0,0,,Kurt!
Dialogue: 0,0:15:19.96,0:15:22.05,Default,,0,0,0,,Sial!
Dialogue: 0,0:15:24.56,0:15:28.39,Default,,0,0,0,,Sicily! Aug! Alirkan sihir ke seragam kalian!
Dialogue: 0,0:15:37.14,0:15:38.95,Default,,0,0,0,,Sihir pelindung?!
Dialogue: 0,0:15:40.57,0:15:42.20,Default,,0,0,0,,Shin, tanganmu!
Dialogue: 0,0:15:42.66,0:15:46.70,Default,,0,0,0,,Tenang saja. Sihir penyembuhnya aktif kok.
Dialogue: 0,0:15:49.03,0:15:51.24,Default Italic,,0,0,0,,Tadi tak kutahan sempurna.
Dialogue: 0,0:15:51.24,0:15:54.00,Default Italic,,0,0,0,,Karena serangan dadakan, pikiranku jadi belum siap.
Dialogue: 0,0:15:54.00,0:15:56.20,Default,,0,0,0,,Kenapa dia ada di sini?
Dialogue: 0,0:15:56.20,0:15:58.51,Default,,0,0,0,,Katanya dia sedang dihukum?
Dialogue: 0,0:15:58.51,0:16:01.35,Default,,0,0,0,,Barusan, dia benar-benar serius ingin membunuh kita.
Dialogue: 0,0:16:01.35,0:16:03.72,Default,,0,0,0,,Ya, tadi itu percobaan pembunuhan.
Dialogue: 0,0:16:03.72,0:16:06.26,Default,,0,0,0,,Hal itu tak bisa kita biarkan.
Dialogue: 0,0:16:08.42,0:16:11.90,Default,,0,0,0,,Sialan, sialan, sialan, sialan, sialan, sialan ....
Dialogue: 0,0:16:12.36,0:16:14.86,Default,,0,0,0,,Sialan!
Dialogue: 0,0:16:15.17,0:16:18.07,Default,,0,0,0,,Sialan!
Dialogue: 0,0:16:18.07,0:16:19.78,Default,,0,0,0,,Hei, Aug,
Dialogue: 0,0:16:19.78,0:16:22.91,Default,,0,0,0,,apa menurutmu dia dalam kendali?
Dialogue: 0,0:16:22.91,0:16:24.62,Default,,0,0,0,,Tidak sama sekali.
Dialogue: 0,0:16:25.08,0:16:26.69,Default,,0,0,0,,Ini buruk, 'kan?
Dialogue: 0,0:16:26.69,0:16:28.04,Default,,0,0,0,,Buruk sekali.
Dialogue: 0,0:16:28.04,0:16:32.12,Default,,0,0,0,,Sialan, sialan ,sialan, sialan!
Dialogue: 0,0:16:38.54,0:16:39.92,Default,,0,0,0,,Yang benar saja?!
Dialogue: 0,0:16:44.01,0:16:46.85,Default,,0,0,0,,Dia menjadi Iblis!
Dialogue: 0,0:16:46.85,0:16:49.66,Default,,0,0,0,,Aug, bawa yang lain pergi dari sini.
Dialogue: 0,0:16:49.66,0:16:51.69,Default,,0,0,0,,Shin, jangan bilang kau ....
Dialogue: 0,0:16:51.69,0:16:53.76,Default,,0,0,0,,Aku akan berusaha menghentikannya.
Dialogue: 0,0:16:53.76,0:16:55.65,Default,,0,0,0,,Jangan gila! Kau juga harus kabur!
Dialogue: 0,0:16:55.65,0:16:58.78,Default,,0,0,0,,Iblis ini tak boleh sampai ke pusat kota, 'kan?!
Dialogue: 0,0:16:58.78,0:17:00.28,Default,,0,0,0,,Kalau begitu, biar kubantu.
Dialogue: 0,0:17:00.28,0:17:03.99,Default,,0,0,0,,Orang yang belum pernah berburu Iblis sepertimu bicara apa?
Dialogue: 0,0:17:04.56,0:17:06.70,Default,,0,0,0,,Jadi kami hanya akan jadi beban begitu?
Dialogue: 0,0:17:09.65,0:17:12.08,Default,,0,0,0,,Ya, hanya akan jadi beban.
Dialogue: 0,0:17:12.86,0:17:14.27,Default,,0,0,0,,Begitu ya?
Dialogue: 0,0:17:17.16,0:17:18.71,Default,,0,0,0,,Ayo kita kabur dari sini!
Dialogue: 0,0:17:18.71,0:17:21.66,Default,,0,0,0,,Tidak! Mana mungkin kita biarkan Shin sendirian?!
Dialogue: 0,0:17:21.66,0:17:23.43,Default,,0,0,0,,Kita hanya akan menjadi bebannya!
Dialogue: 0,0:17:23.43,0:17:24.26,Default,,0,0,0,,Tapi ...!
Dialogue: 0,0:17:24.26,0:17:27.23,Default,,0,0,0,,Messina, bawa Claude pergi dari sini!
Dialogue: 0,0:17:27.23,0:17:28.64,Default,,0,0,0,,Ba-Baik!
Dialogue: 0,0:17:28.64,0:17:30.14,Default,,0,0,0,,Sicily!
Dialogue: 0,0:17:30.97,0:17:32.53,Default,,0,0,0,,Kalian juga pergilah!
Dialogue: 0,0:17:33.48,0:17:36.76,Default,,0,0,0,,Kalian berdua, segera kabari guru soal ini!
Dialogue: 0,0:17:36.76,0:17:37.93,Default,,0,0,0,,Baik!
Dialogue: 0,0:17:36.76,0:17:37.93,Default Top,,0,0,0,,Baik!
Dialogue: 0,0:17:43.60,0:17:45.86,Default,,0,0,0,,Ayo kita mulai, Kurt!
Dialogue: 0,0:18:04.59,0:18:06.97,Default Italic,,0,0,0,,Eh? Tadi seranganku mempan?
Dialogue: 0,0:18:06.97,0:18:09.45,Default Italic,,0,0,0,,Padahal niatku hanya memperlambatnya.
Dialogue: 0,0:18:13.80,0:18:18.36,Default,,0,0,0,,Wolford berengsek!
Dialogue: 0,0:18:18.36,0:18:20.73,Default Italic,,0,0,0,,Iblis yang bisa bicara?
Dialogue: 0,0:18:20.73,0:18:22.78,Default Italic,,0,0,0,,Ini berbeda dari apa yang dikatakan Kakek.
Dialogue: 0,0:18:22.78,0:18:25.95,Default Italic,,0,0,0,,Bukannya Iblis harusnya kehilangan kesadarannya?!
Dialogue: 0,0:18:25.95,0:18:32.49,Default,,0,0,0,,Kubunuh! Akan kubunuh kau, Wolford!
Dialogue: 0,0:18:40.49,0:18:42.38,Default Italic,,0,0,0,,Seranganku benar-benar mempan.
Dialogue: 0,0:18:42.38,0:18:45.42,Default Italic,,0,0,0,,Yang berarti, dia belum sepenuhnya menjadi Iblis.
Dialogue: 0,0:18:45.42,0:18:48.03,Default Italic,,0,0,0,,Jadi pasti ada cara untuk mengembalikannya.
Dialogue: 0,0:18:53.10,0:18:58.08,Default Italic,,0,0,0,,Kalau aku bisa mengendalikan energi sihir yang lepas kendali dari Kurt ....
Dialogue: 0,0:18:58.65,0:19:03.11,Default,,0,0,0,,Wolford!
Dialogue: 0,0:19:05.24,0:19:07.07,Default,,0,0,0,,Jangan-jangan ....
Dialogue: 0,0:19:07.07,0:19:10.41,Default,,0,0,0,,Dia sengaja memusatkan energi sihir untuk meledakkan diri?!
Dialogue: 0,0:19:10.41,0:19:12.04,Default,,0,0,0,,Takkan kubiarkan!
Dialogue: 0,0:19:14.74,0:19:19.25,Default,,0,0,0,,Sial! Dengan energi sihir sebesar ini, seluruh Akademi bisa hancur!
Dialogue: 0,0:19:19.25,0:19:20.63,Default,,0,0,0,,Berakhir sudah!
Dialogue: 0,0:19:20.63,0:19:23.96,Default Italic,,0,0,0,,Bagaimana? Bagaimana ini?!
Dialogue: 0,0:19:27.50,0:19:30.33,Default Italic,,0,0,0,,Tidak ada waktu lagi.
Dialogue: 0,0:19:38.31,0:19:40.56,Default Italic,,0,0,0,,Maafkan aku, Kurt!
Dialogue: 0,0:20:04.66,0:20:07.76,Default Italic,,0,0,0,,Ini pertama kalinya aku membunuh seorang manusia ....
Dialogue: 0,0:20:09.79,0:20:14.20,Default Italic,,0,0,0,,Sial, apa-apaan ini? Apa yang terjadi?
Dialogue: 0,0:20:15.46,0:20:17.82,Default,,0,0,0,,Kau tidak apa-apa, Shin?
Dialogue: 0,0:20:22.56,0:20:26.56,Default,,0,0,0,,Shin! Lukamu .... Apa kau terluka?
Dialogue: 0,0:20:26.56,0:20:29.40,Default,,0,0,0,,Oh, aku baik-baik saja kok.
Dialogue: 0,0:20:29.40,0:20:33.45,Default,,0,0,0,,Tak kusangka kau mengalahkan Iblis seorang diri.
Dialogue: 0,0:20:33.45,0:20:35.46,Default,,0,0,0,,Kalian semua melihatnya?
Dialogue: 0,0:20:35.46,0:20:36.56,Default,,0,0,0,,Ya.
Dialogue: 0,0:20:41.11,0:20:44.02,Default,,0,0,0,,Apa memang tidak ada pilihan lain ya?
Dialogue: 0,0:20:45.41,0:20:47.97,Default,,0,0,0,,Dia menguntit Sicily ...
Dialogue: 0,0:20:49.04,0:20:52.22,Default,,0,0,0,,... bahkan sampai berubah menjadi Iblis ....
Dialogue: 0,0:20:52.75,0:20:54.40,Default,,0,0,0,,Walau begitu ....
Dialogue: 0,0:20:54.40,0:20:56.10,Default,,0,0,0,,Shin ....
Dialogue: 0,0:22:35.85,0:22:38.53,Default,,0,0,0,,Shin, mulai sekarang kau akan kerepotan.
Dialogue: 0,0:22:38.53,0:22:39.87,Default,,0,0,0,,Eh?
Dialogue: 0,0:22:39.87,0:22:43.37,Default,,0,0,0,,Ini adalah kemunculan manusia Iblis kedua dalam sejarah.
Dialogue: 0,0:22:43.68,0:22:47.56,Default,,0,0,0,,Hal ini mampu mengguncang kerajaan, dan kau mengatasinya begitu saja.
Dialogue: 0,0:22:47.56,0:22:49.08,Default,,0,0,0,,Yang Mulia!
Dialogue: 0,0:22:49.57,0:22:51.09,Default,,0,0,0,,Kau tidak apa-apa?
Dialogue: 0,0:22:51.09,0:22:53.17,Default,,0,0,0,,Kami mendengar laporan munculnya Iblis!
Dialogue: 0,0:22:53.17,0:22:55.62,Default,,0,0,0,,Di mana Iblisnya?
Dialogue: 0,0:22:55.62,0:22:58.24,Default,,0,0,0,,Dia di sana, sudah dikalahkan ....
Dialogue: 0,0:23:00.63,0:23:01.72,Default,,0,0,0,,Jangan-jangan ....
Dialogue: 0,0:23:01.72,0:23:04.89,Default,,0,0,0,,Kau yang sudah mengalahkannya?!
Dialogue: 0,0:23:04.89,0:23:07.29,Default,,0,0,0,,Bukan aku.
Dialogue: 0,0:23:07.29,0:23:09.31,Default,,0,0,0,,Kalian semua, dengar ini baik-baik!
Dialogue: 0,0:23:09.70,0:23:15.53,Default,,0,0,0,,Iblisnya telah dikalahkan oleh Shin Wolford yang merupakan cucu dari sang Penyihir Bijak, Merlin!
Dialogue: 0,0:23:19.02,0:23:21.23,Default,,0,0,0,,Dia mengalahkan Iblis seorang diri?!
Dialogue: 0,0:23:21.23,0:23:23.73,Default,,0,0,0,,Cucu sang Penyihir Bijak memang hebat!
Dialogue: 0,0:23:23.73,0:23:25.42,Default,,0,0,0,,Pahlawan baru kita!
Dialogue: 0,0:23:25.42,0:23:27.08,Default,,0,0,0,,Shin Wolford!
Dialogue: 0,0:23:27.08,0:23:31.54,Default,,0,0,0,,Shin! Shin! Shin! Shin!
Dialogue: 0,0:23:31.54,0:23:34.20,Default,,0,0,0,,Eh, jangan begitu ....
Dialogue: 0,0:23:36.54,0:23:40.18,Default Italic,,0,0,0,,Jadi ini maksudnya aku bakal kerepotan?
