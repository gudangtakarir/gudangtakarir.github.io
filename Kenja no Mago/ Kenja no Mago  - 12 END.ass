Dialogue: 0,0:00:04.35,0:00:07.15,Default,,0,0,0,,Nona Sicily, tolong sebelah sini.
Dialogue: 0,0:00:07.15,0:00:08.07,Default,,0,0,0,,Baik!
Dialogue: 0,0:00:18.27,0:00:19.72,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:00:19.72,0:00:22.51,Default,,0,0,0,,Tidak apa-apa, sekarang berisitirahatlah.
Dialogue: 0,0:00:27.28,0:00:29.21,Default,,0,0,0,,Nona Sicily!
Dialogue: 0,0:00:30.63,0:00:34.78,Default,,0,0,0,,Kumohon! Tolonglah, tolong periksakan suamiku!
Dialogue: 0,0:00:38.81,0:00:41.10,Default,,0,0,0,,Sial! Pendarahannya tak berhenti!
Dialogue: 0,0:00:41.10,0:00:42.18,Default,,0,0,0,,Nona Sicily!
Dialogue: 0,0:00:45.34,0:00:46.94,Default,,0,0,0,,Ini ....
Dialogue: 0,0:00:46.94,0:00:51.65,Default,,0,0,0,,Kumohon selamatkan Suamiku! Akan kulakukan apa pun!
Dialogue: 0,0:00:58.37,0:01:01.58,Default Italic,,0,0,0,,Kekuatan sihir apa ini?!
Dialogue: 0,0:01:07.08,0:01:09.96,Default,,0,0,0,,Tingkat kemampuannya berbeda dari yang lain.
Dialogue: 0,0:01:14.96,0:01:16.68,Default,,0,0,0,,Semuanya, mundurlah!
Dialogue: 0,0:01:16.92,0:01:18.32,Default,,0,0,0,,Ta-Tapi ...!
Dialogue: 0,0:01:18.32,0:01:20.22,Default,,0,0,0,,Maaf, tapi kalian hanya kan jadi beban!
Dialogue: 0,0:01:20.22,0:01:21.47,Default,,0,0,0,,Ba-Baiklah.
Dialogue: 0,0:01:23.08,0:01:24.52,Default,,0,0,0,,Siapa kalian?
Dialogue: 0,0:01:24.85,0:01:27.98,Default,,0,0,0,,Kami Ultimate Magicians!
Dialogue: 0,0:03:09.12,0:03:10.75,Default,,0,0,0,,Menghilang?!
Dialogue: 0,0:03:11.00,0:03:14.13,Default,,0,0,0,,Lagi-lagi tanpa mantera? Cukup merepotkan.
Dialogue: 0,0:03:14.92,0:03:15.84,Default,,0,0,0,,Terima ini!
Dialogue: 0,0:03:22.05,0:03:24.14,Default,,0,0,0,,Mungkin aku terlalu berlebihan ....
Dialogue: 0,0:03:24.14,0:03:25.85,Default,,0,0,0,,Alice! Di belakangmu!
Dialogue: 0,0:03:32.81,0:03:33.98,Default,,0,0,0,,Alat sihir?
Dialogue: 0,0:03:33.98,0:03:35.40,Default,,0,0,0,,Sialan!
Dialogue: 0,0:03:41.70,0:03:43.11,Default,,0,0,0,,Alice, menyingkirlah!
Dialogue: 0,0:03:44.12,0:03:46.49,Default,,0,0,0,,Di-Dia sangat kuat!
Dialogue: 0,0:03:49.37,0:03:51.87,Default,,0,0,0,,Gaya bertarungmu masih amatiran.
Dialogue: 0,0:03:55.08,0:03:58.55,Default Italic,,0,0,0,,Bantuan?! Jangan-jangan dari tuan Zest ....
Dialogue: 0,0:03:59.96,0:04:02.51,Default Italic,,0,0,0,,Pokoknya, ini kesempatan!
Dialogue: 0,0:04:03.22,0:04:06.60,Default,,0,0,0,,Semuanya, mundur! Ini perintah!
Dialogue: 0,0:04:06.60,0:04:09.56,Default,,0,0,0,,Semua manusia Iblis diperintahkan untuk mundur!
Dialogue: 0,0:04:09.56,0:04:11.64,Default,,0,0,0,,Apa?! Mundur katanya?
Dialogue: 0,0:04:11.64,0:04:13.44,Default,,0,0,0,,Aku belum puas!
Dialogue: 0,0:04:13.44,0:04:14.94,Default,,0,0,0,,Kenapa sama manusia biasa ....
Dialogue: 0,0:04:16.27,0:04:20.65,Default,,0,0,0,,Situasi kita sedang dirugikan! Segera mundur dan berkumpul!
Dialogue: 0,0:04:25.91,0:04:26.66,Default,,0,0,0,,Sialan!
Dialogue: 0,0:04:26.87,0:04:27.91,Default,,0,0,0,,Hei!
Dialogue: 0,0:04:27.91,0:04:29.62,Default,,0,0,0,,Jangan menghalangi!
Dialogue: 0,0:04:29.62,0:04:30.83,Default,,0,0,0,,Kubunuh kau!
Dialogue: 0,0:04:39.00,0:04:41.88,Default,,0,0,0,,Di pikir bisa kabur begitu saja?
Dialogue: 0,0:05:03.28,0:05:05.20,Default,,0,0,0,,Takkan kubiarkan!
Dialogue: 0,0:05:10.83,0:05:12.16,Default,,0,0,0,,Ly-Lynn!
Dialogue: 0,0:05:12.58,0:05:14.79,Default,,0,0,0,,Alice sudah tertangkap!
Dialogue: 0,0:05:14.79,0:05:16.50,Default,,0,0,0,,Situasinya cukup gawat.
Dialogue: 0,0:05:16.83,0:05:18.58,Default,,0,0,0,,Yuri, bantu!
Dialogue: 0,0:05:18.58,0:05:20.04,Default,,0,0,0,,Aku serang dari belakang!
Dialogue: 0,0:05:22.46,0:05:23.97,Default,,0,0,0,,Eh?! Wah!
Dialogue: 0,0:05:23.97,0:05:26.51,Default,,0,0,0,,Bohong! Tidak, tunggu sebentar!
Dialogue: 0,0:05:29.30,0:05:30.72,Default,,0,0,0,,Yuri! Alice!
Dialogue: 0,0:05:37.02,0:05:38.60,Default,,0,0,0,,Gawat!
Dialogue: 0,0:05:46.45,0:05:47.32,Default,,0,0,0,,Lynn!
Dialogue: 0,0:05:50.70,0:05:54.29,Default,,0,0,0,,Berengsek ...!
Dialogue: 0,0:05:56.21,0:05:57.87,Default,,0,0,0,,Gawat, Tony!
Dialogue: 0,0:06:05.09,0:06:06.76,Default,,0,0,0,,Alice!
Dialogue: 0,0:06:12.56,0:06:13.85,Default,,0,0,0,,Tunggu!
Dialogue: 0,0:06:19.56,0:06:21.69,Default,,0,0,0,,Wolford!
Dialogue: 0,0:06:23.48,0:06:25.11,Default Italic,,0,0,0,,Jadi dia ...
Dialogue: 0,0:06:25.44,0:06:27.53,Default Italic,,0,0,0,,... Shin Wolford?
Dialogue: 0,0:06:39.29,0:06:44.25,Default,,0,0,0,,Wo-Wolford, dia bukan amatir.
Dialogue: 0,0:06:44.25,0:06:45.63,Default,,0,0,0,,Tenang saja.
Dialogue: 0,0:06:45.63,0:06:47.01,Default,,0,0,0,,Aku juga.
Dialogue: 0,0:06:47.01,0:06:49.47,Default,,0,0,0,,Yuri, jaga yang lain.
Dialogue: 0,0:06:49.47,0:06:51.09,Default,,0,0,0,,Ba-Baik.
Dialogue: 0,0:06:53.14,0:06:56.56,Default Italic,,0,0,0,,Lawrencen sepertinya sudah berhasil.
Dialogue: 0,0:06:56.56,0:06:58.81,Default,,0,0,0,,Beraninya kau melakukan semua ini ....
Dialogue: 0,0:06:58.81,0:07:03.36,Default Italic,,0,0,0,,Sekarang, waktunya memastikan seberapa kuat kemampuannya.
Dialogue: 0,0:07:15.20,0:07:16.95,Default Italic,,0,0,0,,Dua lapis di saat bersamaan?!
Dialogue: 0,0:07:21.25,0:07:23.58,Default Italic,,0,0,0,,Kalau saja aku sedikit lambat ....
Dialogue: 0,0:07:23.58,0:07:25.00,Default,,0,0,0,,Shin!
Dialogue: 0,0:07:25.00,0:07:26.46,Default,,0,0,0,,Kau tidak apa-apa?!
Dialogue: 0,0:07:26.46,0:07:28.21,Default,,0,0,0,,Kami datang membantu.
Dialogue: 0,0:07:28.88,0:07:31.72,Default Italic,,0,0,0,,Sepertinya sudah waktunya untuk pergi.
Dialogue: 0,0:07:32.43,0:07:35.30,Default,,0,0,0,,Semua! Menyingkir!
Dialogue: 0,0:07:38.06,0:07:39.18,Default,,0,0,0,,Sialan!
Dialogue: 0,0:07:41.19,0:07:44.73,Default,,0,0,0,,Sekarang! Pakai sihir ledakan!
Dialogue: 0,0:07:48.57,0:07:49.90,Default,,0,0,0,,Apa?!
Dialogue: 0,0:07:53.74,0:07:56.58,Default,,0,0,0,,Aug! Lindungi yang lainnya!
Dialogue: 0,0:08:19.52,0:08:21.43,Default,,0,0,0,,Me-Menghilang ....
Dialogue: 0,0:08:21.43,0:08:22.14,Default,,0,0,0,,Shin!
Dialogue: 0,0:08:23.10,0:08:24.19,Default,,0,0,0,,Teman-teman ....
Dialogue: 0,0:08:24.19,0:08:26.15,Default,,0,0,0,,Wolford ....
Dialogue: 0,0:08:26.69,0:08:29.19,Default,,0,0,0,,Syukurlah, kalian tidak apa-apa.
Dialogue: 0,0:08:31.07,0:08:34.03,Default,,0,0,0,,Maaf. Manusia Iblisnya berhasil kabur.
Dialogue: 0,0:08:34.03,0:08:36.32,Default,,0,0,0,,Tidak, aku justru yang harus minta maaf.
Dialogue: 0,0:08:36.32,0:08:38.74,Default,,0,0,0,,Shin, manusia Iblis wanita tadi ....
Dialogue: 0,0:08:38.74,0:08:41.66,Default,,0,0,0,,Ya, dia sangat kuat.
Dialogue: 0,0:08:41.66,0:08:45.00,Default,,0,0,0,,Mungkin dia mantan prajurit atau pemburu.
Dialogue: 0,0:08:45.00,0:08:46.46,Default,,0,0,0,,Sampai orang seperti itu ....
Dialogue: 0,0:08:46.83,0:08:50.42,Default,,0,0,0,,Tetapi, apa tujuan dari serangan ini?
Dialogue: 0,0:08:50.42,0:08:52.30,Default,,0,0,0,,Gerakan Schtrom sangat tidak terbaca.
Dialogue: 0,0:08:52.63,0:08:57.30,Default,,0,0,0,,Setidaknya, dia tidak ada di sini, kalau ada ...
Dialogue: 0,0:08:57.30,0:08:59.14,Default,,0,0,0,,... kita pasti akan terluka parah.
Dialogue: 0,0:09:00.51,0:09:04.52,Default,,0,0,0,,Walau begitu, sampai bisa menciptakan kerusakan sebesar ini ....
Dialogue: 0,0:09:04.52,0:09:08.36,Default,,0,0,0,,Daripada itu, sebaiknya kita lakukan apa yang kita bisa.
Dialogue: 0,0:09:08.69,0:09:10.94,Default,,0,0,0,,Aku juga khawatir pada Sicily.
Dialogue: 0,0:09:10.94,0:09:12.90,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:09:12.90,0:09:16.11,Default,,0,0,0,,Untuk sekarang, kalian awasi kemunculan manusia Iblis.
Dialogue: 0,0:09:16.11,0:09:17.74,Default,,0,0,0,,Tapi jangan berlebihan.
Dialogue: 0,0:09:17.74,0:09:19.58,Default,,0,0,0,,Baik!
Dialogue: 0,0:09:27.33,0:09:29.54,Default,,0,0,0,,Apa?! Tuan Zest yang bilang?
Dialogue: 0,0:09:29.84,0:09:34.34,Default,,0,0,0,,Ya. Dia meminta bantuanku untuk memberi kesempatan bagimu untuk kabur.
Dialogue: 0,0:09:36.26,0:09:40.89,Default Italic,,0,0,0,,Tetapi, kekuatan Wolford dan yang lain di luar dugaan.
Dialogue: 0,0:09:40.89,0:09:43.60,Default Italic,,0,0,0,,Kita juga kehilangan banyak pion.
Dialogue: 0,0:09:44.77,0:09:48.19,Default,,0,0,0,,Menyerang dengan gagah lalu mundur,
Dialogue: 0,0:09:48.44,0:09:52.32,Default,,0,0,0,,dengan penuh kegagalan, benar-benar payah.
Dialogue: 0,0:09:52.94,0:09:56.53,Default,,0,0,0,,Setelah menghancurkan Kekaisaran, kegiatanku semakin membosankan.
Dialogue: 0,0:09:57.11,0:10:03.62,Default,,0,0,0,,Tapi Shin Wolford, selama ada kau mungkin aku bisa melupakan kebosananku.
Dialogue: 0,0:10:14.88,0:10:16.22,Default,,0,0,0,,Da-Datang dari langit!
Dialogue: 0,0:10:16.22,0:10:17.13,Default,,0,0,0,,Manusia Iblis!
Dialogue: 0,0:10:17.55,0:10:21.26,Default,,0,0,0,,Tenanglah. Kami adalah Ultimate Magicians.
Dialogue: 0,0:10:22.30,0:10:24.22,Default,,0,0,0,,Bagaimana tempat perawatannya?
Dialogue: 0,0:10:24.47,0:10:27.73,Default,,0,0,0,,Nona Sicily di dalam sedang mengobati.
Dialogue: 0,0:10:27.73,0:10:28.94,Default,,0,0,0,,Tapi ....
Dialogue: 0,0:10:36.74,0:10:39.32,Default,,0,0,0,,Pangeran! Wolford!
Dialogue: 0,0:10:40.03,0:10:42.70,Default,,0,0,0,,Bean, bagaimana dengan serangan Iblisnya?
Dialogue: 0,0:10:42.70,0:10:44.79,Default,,0,0,0,,Olivia dan aku sudah mengatasinya.
Dialogue: 0,0:10:44.79,0:10:46.41,Default,,0,0,0,,Sicily mana?!
Dialogue: 0,0:10:46.41,0:10:48.58,Default,,0,0,0,,Sedang mengobati korban di dalam.
Dialogue: 0,0:10:48.83,0:10:50.25,Default,,0,0,0,,Begitu ....
Dialogue: 0,0:10:50.25,0:10:55.42,Default,,0,0,0,,Kita di sini kekurangan orang, panggil yang lain untuk membantu.
Dialogue: 0,0:10:55.42,0:10:57.05,Default,,0,0,0,,Shin kau bantu Claude.
Dialogue: 0,0:10:57.05,0:10:58.22,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:11:11.90,0:11:14.44,Default,,0,0,0,,Ba-Bagaimana ini ...?!
Dialogue: 0,0:11:17.65,0:11:19.78,Default,,0,0,0,,Nona Sicily?
Dialogue: 0,0:11:22.82,0:11:26.45,Default,,0,0,0,,Maaf .... Aku sudah ...
Dialogue: 0,0:11:26.87,0:11:28.54,Default,,0,0,0,,... tidak bisa melakukan apa-apa lagi ....
Dialogue: 0,0:11:28.54,0:11:29.79,Default,,0,0,0,,Tidak!
Dialogue: 0,0:11:30.16,0:11:33.79,Default,,0,0,0,,Sihir penyembuhan ... tak bisa menyembuhkan segalanya ....
Dialogue: 0,0:11:47.43,0:11:48.97,Default,,0,0,0,,Nona Sicily?!
Dialogue: 0,0:11:48.97,0:11:50.39,Default,,0,0,0,,Apa yang kau lakukan?!
Dialogue: 0,0:11:50.81,0:11:54.40,Default,,0,0,0,,Pakaian ini ditanam sihir penyembuhan!
Dialogue: 0,0:11:54.40,0:11:55.77,Default,,0,0,0,,Kalau pakai ini ....
Dialogue: 0,0:11:55.77,0:11:57.40,Default,,0,0,0,,Sicily!
Dialogue: 0,0:11:58.82,0:12:00.44,Default,,0,0,0,,Shin ...?
Dialogue: 0,0:12:00.44,0:12:04.91,Default,,0,0,0,,Pakai alat sihir pun, lukanya takkan sembuh.
Dialogue: 0,0:12:05.91,0:12:09.54,Default,,0,0,0,,Tidak .... Jadi dia ....
Dialogue: 0,0:12:10.50,0:12:14.17,Default,,0,0,0,,Tenang saja. Aku akan menolongnya.
Dialogue: 0,0:12:19.05,0:12:21.26,Default Italic,,0,0,0,,Luar biasa dia masih bisa bertahan.
Dialogue: 0,0:12:21.80,0:12:25.55,Default Italic,,0,0,0,,Sihir penyembuhan Sicily membantunya bertahan hidup.
Dialogue: 0,0:12:27.51,0:12:32.23,Default Italic,,0,0,0,,Jangan langsung sembuhkan semua, fokuskan satu persatu bagian yang terluka ....
Dialogue: 0,0:12:38.15,0:12:42.11,Default Italic,,0,0,0,,Shin, seberapa kuat sebenarnya dirimu?
Dialogue: 0,0:12:42.11,0:12:44.86,Default Italic,,0,0,0,,Sepertinya, kau memang tiada tanding.
Dialogue: 0,0:12:50.95,0:12:52.58,Default,,0,0,0,,Pernapasannya sudah stabil.
Dialogue: 0,0:12:53.16,0:12:54.79,Default,,0,0,0,,Dia akan baik-baik saja.
Dialogue: 0,0:12:54.79,0:12:59.88,Default,,0,0,0,,Terima kasih banyak! Aku benar-benar berterimakasih!
Dialogue: 0,0:12:59.88,0:13:02.13,Default,,0,0,0,,Bagaimana harus kubalas kebaikanmu?!
Dialogue: 0,0:13:06.51,0:13:07.89,Default,,0,0,0,,Sicily?
Dialogue: 0,0:13:09.10,0:13:14.98,Default,,0,0,0,,Shin memang luar biasa. Aku takkan pernah bisa menyamaimu.
Dialogue: 0,0:13:15.27,0:13:17.02,Default,,0,0,0,,Itu tidaklah benar.
Dialogue: 0,0:13:17.90,0:13:23.24,Default,,0,0,0,,Aku selalu bergantung padamu dan ditolong olehmu,
Dialogue: 0,0:13:23.24,0:13:27.78,Default,,0,0,0,,aku sungguh menyedihkan ... karena tak mampu berbuat apa-apa ....
Dialogue: 0,0:13:27.78,0:13:32.91,Default,,0,0,0,,Itu tidak benar kok. Alasan pria itu bisa diselamatkan olehku adalah berkat usahamu.
Dialogue: 0,0:13:33.58,0:13:36.46,Default,,0,0,0,,Kau sudah menyembuhkan banyak orang, 'kan?
Dialogue: 0,0:13:36.46,0:13:37.71,Default,,0,0,0,,Tapi ...!
Dialogue: 0,0:13:37.71,0:13:39.04,Default,,0,0,0,,Lihatlah.
Dialogue: 0,0:13:40.50,0:13:42.34,Default,,0,0,0,,Terima kasih banyak!
Dialogue: 0,0:13:42.34,0:13:44.80,Default,,0,0,0,,Terima kasih ya.
Dialogue: 0,0:13:44.80,0:13:47.72,Default,,0,0,0,,Ini adalah orang yang sudah kau selamatkan.
Dialogue: 0,0:13:49.55,0:13:53.64,Default,,0,0,0,,Yang sudah menyelamatkan mereka semua, tidak lain adalah dirimu.
Dialogue: 0,0:13:53.64,0:13:55.43,Default,,0,0,0,,Kau sudah berjuang keras ya.
Dialogue: 0,0:13:56.85,0:13:58.81,Default,,0,0,0,,Kau bagaikan seorang santa.
Dialogue: 0,0:13:58.81,0:13:59.90,Default,,0,0,0,,Santa.
Dialogue: 0,0:14:01.52,0:14:02.73,Default,,0,0,0,,Eh?
Dialogue: 0,0:14:02.73,0:14:04.23,Default,,0,0,0,,Eh?!
Dialogue: 0,0:14:30.18,0:14:34.85,Default,,0,0,0,,Raja Sweed, mengenai serangan manusia Iblis,
Dialogue: 0,0:14:34.85,0:14:36.98,Default,,0,0,0,,ada beberapa hal yang kupertanyakan.
Dialogue: 0,0:14:37.39,0:14:40.81,Default,,0,0,0,,Salah satunya, Iblis yang terlibat penyerangan Kekaisaran,
Dialogue: 0,0:14:40.81,0:14:42.65,Default,,0,0,0,,tidak muncul di sini.
Dialogue: 0,0:14:42.65,0:14:43.94,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:14:44.44,0:14:48.24,Default,,0,0,0,,Satu lagi adalah pemimpin Manusia Iblis, Oliver Schtrom.
Dialogue: 0,0:14:48.24,0:14:50.41,Default,,0,0,0,,Oliver Schtrom?
Dialogue: 0,0:14:51.12,0:14:53.70,Default,,0,0,0,,Dia yang sudah menghancurkan Kekasiaran,
Dialogue: 0,0:14:53.70,0:14:57.62,Default,,0,0,0,,kenapa tanpa alasan mengirim manusia Iblis kemari?
Dialogue: 0,0:14:57.62,0:15:00.75,Default,,0,0,0,,Kukira serangan ini hanya pengalih perhatian,
Dialogue: 0,0:15:01.67,0:15:04.25,Default,,0,0,0,,tapi tak ada laporan bahwa terjadi penyerangan lain.
Dialogue: 0,0:15:06.05,0:15:10.38,Default,,0,0,0,,Dia pernah bertarung melawan Schtrom dan mengusirnya pergi.
Dialogue: 0,0:15:11.26,0:15:13.93,Default,,0,0,0,,Baginya Shin pasti sebuah ancaman.
Dialogue: 0,0:15:13.93,0:15:16.68,Default,,0,0,0,,Rasanya mustahil bahwa di insiden kali ini ...
Dialogue: 0,0:15:16.68,0:15:19.89,Default,,0,0,0,,... dia tidak menduga adanya keterlibatan Earlsheid dan Shin.
Dialogue: 0,0:15:20.19,0:15:21.40,Default,,0,0,0,,Jadi ....
Dialogue: 0,0:15:21.40,0:15:24.40,Default,,0,0,0,,Jujur, aku tidak tahu apa tujuannya.
Dialogue: 0,0:15:24.40,0:15:27.19,Default,,0,0,0,,Mungkin diantara Manusia Iblis telah terjadi sesuatu.
Dialogue: 0,0:15:27.19,0:15:31.16,Default,,0,0,0,,Kalau benar, kita harus lebih waspada dari biasanya.
Dialogue: 0,0:15:31.16,0:15:32.49,Default,,0,0,0,,Itu benar.
Dialogue: 0,0:15:34.20,0:15:37.95,Default,,0,0,0,,Raja Sweed, dengan ini aku menawarkan aliansi ...
Dialogue: 0,0:15:37.95,0:15:40.75,Default,,0,0,0,,... dan membentuk Pasukan Bersatu.
Dialogue: 0,0:15:40.75,0:15:42.29,Default,,0,0,0,,Bisakah aku meminta keikutsertaanmu?
Dialogue: 0,0:15:43.33,0:15:46.67,Default,,0,0,0,,Aliansi ya? Apakah di aliansi ini,
Dialogue: 0,0:15:46.67,0:15:49.30,Default,,0,0,0,,Kerajaan Earlsheid juga akan ikut serta?
Dialogue: 0,0:15:49.59,0:15:50.47,Default,,0,0,0,,Iya.
Dialogue: 0,0:15:50.47,0:15:51.26,Default Italic,,0,0,0,,Eh?
Dialogue: 0,0:15:51.55,0:15:56.01,Default,,0,0,0,,Memang benar, masalah ini terlalu besar jika dipikul sebuah Negeri.
Dialogue: 0,0:15:56.89,0:15:59.47,Default,,0,0,0,,Baiklah. Kami akan mempertimbangkannya.
Dialogue: 0,0:15:59.98,0:16:01.69,Default,,0,0,0,,Terima kasih banyak.
Dialogue: 0,0:16:03.35,0:16:06.90,Default,,0,0,0,,Beberapa hari lagi, akan diadakan pertemuan berbagai Negeri.
Dialogue: 0,0:16:06.90,0:16:09.07,Default,,0,0,0,,Akan kuhubungi saat waktu sudah ditentukan.
Dialogue: 0,0:16:09.07,0:16:11.82,Default,,0,0,0,,Ya, aku akan menantikannya.
Dialogue: 0,0:16:13.74,0:16:18.29,Default,,0,0,0,,Aliansi dengan Negeri lain ya? Kau sudah berpikir banyak ternyata.
Dialogue: 0,0:16:18.29,0:16:20.54,Default,,0,0,0,,Apa maksudnya itu?
Dialogue: 0,0:16:20.54,0:16:24.42,Default,,0,0,0,,Aug, ada satu hal yang aku sesali.
Dialogue: 0,0:16:25.04,0:16:27.54,Default,,0,0,0,,Kalau kita datang pakai Gate,
Dialogue: 0,0:16:27.54,0:16:30.42,Default,,0,0,0,,mungkin korbannya bisa lebih berkurang lagi.
Dialogue: 0,0:16:30.96,0:16:36.09,Default,,0,0,0,,Tapi Gate cuma bisa terhubung ke tempat yang pernah dikunjungi, 'kan?
Dialogue: 0,0:16:36.09,0:16:36.85,Default,,0,0,0,,Ya.
Dialogue: 0,0:16:37.18,0:16:39.26,Default,,0,0,0,,Karena itu, aku ada permintaan.
Dialogue: 0,0:16:39.51,0:16:44.35,Default,,0,0,0,,Kebetulan sekali, aku juga memiliki permintaan padamu.
Dialogue: 0,0:16:44.98,0:16:47.27,Default,,0,0,0,,Mari kita lindungi Dunia ini!
Dialogue: 0,0:16:50.19,0:16:52.19,Default,,0,0,0,,Kalian juga akan ikut membantu, 'kan?
Dialogue: 0,0:16:52.19,0:16:53.65,Default,,0,0,0,,Ya!
Dialogue: 0,0:16:52.19,0:16:53.65,Default Top,,0,0,0,,Tentu!
Dialogue: 0,0:17:00.91,0:17:01.58,Default,,0,0,0,,Eh?
Dialogue: 0,0:17:01.58,0:17:04.08,Default,,0,0,0,,Yang Mulia Pangeran telah kembali!
Dialogue: 0,0:17:04.08,0:17:06.50,Default,,0,0,0,,Selamat karena telah mengusir Manusia Iblis!
Dialogue: 0,0:17:09.84,0:17:12.51,Default,,0,0,0,,Ultimate Magicians!
Dialogue: 0,0:17:12.51,0:17:15.38,Default,,0,0,0,,Sepertinya kabar sudah tersebar ya.
Dialogue: 0,0:17:15.38,0:17:17.34,Default,,0,0,0,,Duh, namanya itu loh ....
Dialogue: 0,0:17:17.34,0:17:19.64,Default,,0,0,0,,Menurutku nama yang bagus kok!
Dialogue: 0,0:17:19.64,0:17:23.23,Default,,0,0,0,,Biarkan saja dia, Claude. Nanti juga terbiasa.
Dialogue: 0,0:17:23.23,0:17:25.06,Default,,0,0,0,,August!
Dialogue: 0,0:17:25.06,0:17:27.10,Default,,0,0,0,,Aku sangat khawatir!
Dialogue: 0,0:17:27.10,0:17:30.77,Default,,0,0,0,,Ellie? May? Kalian seharusnya tidak boleh kemari!
Dialogue: 0,0:17:30.77,0:17:32.86,Default,,0,0,0,,Tidak apa-apa. Aku sudah mengizinkannya.
Dialogue: 0,0:17:32.86,0:17:34.65,Default,,0,0,0,,Ayahanda!
Dialogue: 0,0:17:34.65,0:17:36.53,Default,,0,0,0,,Kakek sama Nenek juga ada!
Dialogue: 0,0:17:37.03,0:17:39.41,Default,,0,0,0,,Kalian sudah berjuang keras.
Dialogue: 0,0:17:39.41,0:17:42.29,Default,,0,0,0,,Hasil latihannya sudah terlihat ya?
Dialogue: 0,0:17:42.29,0:17:43.33,Default,,0,0,0,,Iya!
Dialogue: 0,0:17:43.33,0:17:46.87,Default,,0,0,0,,Eh? May, kenapa ekspresimu begitu?
Dialogue: 0,0:17:47.75,0:17:51.09,Default,,0,0,0,,Dadanya Ellie begitu besar ....
Dialogue: 0,0:17:54.26,0:17:56.68,Default,,0,0,0,,Benar sih, sangat berbahaya.
Dialogue: 0,0:17:56.68,0:17:58.72,Default,,0,0,0,,Aku jadi ingin merenggutnya.
Dialogue: 0,0:17:58.72,0:17:59.55,Default,,0,0,0,,Boleh juga.
Dialogue: 0,0:17:59.55,0:18:01.60,Default,,0,0,0,,Jangan renggut apa pun!
Dialogue: 0,0:18:01.60,0:18:06.23,Default,,0,0,0,,Daripada itu, Ayah, ada yang ingin kulaporkan tentang insiden kali ini ....
Dialogue: 0,0:18:06.23,0:18:10.15,Default,,0,0,0,,Kau kalau soal ini selalu serius ya?
Dialogue: 0,0:18:11.52,0:18:15.24,Default,,0,0,0,,Begitu. Jadi Raja Sweed sudah setuju ya.
Dialogue: 0,0:18:15.24,0:18:17.99,Default,,0,0,0,,Ayahanda, apakah kau mau mempercayakanku ...
Dialogue: 0,0:18:18.53,0:18:20.91,Default,,0,0,0,,... sebagai Negosiator dengan Negeri lain?
Dialogue: 0,0:18:21.53,0:18:25.54,Default,,0,0,0,,Aku adalah Pangeran dan juga bagian dari Ultimate Magicians.
Dialogue: 0,0:18:25.54,0:18:27.46,Default,,0,0,0,,Pasti akan mudah bernegosiasi.
Dialogue: 0,0:18:28.04,0:18:29.62,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:18:30.54,0:18:32.79,Default,,0,0,0,,Maukah kau melakukanya, August?
Dialogue: 0,0:18:33.21,0:18:35.96,Default,,0,0,0,,Dengan senang hati, akan kulakukan.
Dialogue: 0,0:18:35.96,0:18:38.88,Default,,0,0,0,,Akan kusukseskan negosiasi dengan Negeri lain.
Dialogue: 0,0:18:40.01,0:18:43.06,Default,,0,0,0,,Kakek, Nenek ....
Dialogue: 0,0:18:43.06,0:18:48.31,Default,,0,0,0,,Kami tahu, kau juga harus ikut dalam perjalanan ini, 'kan?
Dialogue: 0,0:18:48.31,0:18:50.81,Default,,0,0,0,,Pergilah dan lihat dunia ini.
Dialogue: 0,0:18:50.81,0:18:52.27,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:18:52.27,0:18:53.69,Default,,0,0,0,,Kalau begitu ....
Dialogue: 0,0:18:53.69,0:18:55.78,Default,,0,0,0,,Kami juga akan ikut serta.
Dialogue: 0,0:18:55.78,0:18:56.40,Default,,0,0,0,,Ya!
Dialogue: 0,0:18:56.40,0:18:59.57,Default,,0,0,0,,Kalian ini, kita bukan pergi main tahu!
Dialogue: 0,0:18:59.57,0:19:02.62,Default,,0,0,0,,Tidak ada salahnya, 'kan? Perjalanan kita cukup panjang soalnya.
Dialogue: 0,0:19:02.62,0:19:06.95,Default,,0,0,0,,Jadi mana mungkin kau mengabaikan Tunangan serta adik perempuanmu.
Dialogue: 0,0:19:06.95,0:19:08.50,Default,,0,0,0,,Tapi ....
Dialogue: 0,0:19:08.50,0:19:11.42,Default,,0,0,0,,Kami berdua yang akan menjaga mereka.
Dialogue: 0,0:19:11.42,0:19:15.42,Default,,0,0,0,,Diantara anggota kita, hanya kami yang cocok jadi penjaga.
Dialogue: 0,0:19:15.42,0:19:16.76,Default,,0,0,0,,Astaga ....
Dialogue: 0,0:19:18.17,0:19:19.88,Default,,0,0,0,,Baiklah, Ayahanda ...
Dialogue: 0,0:19:20.26,0:19:23.60,Default,,0,0,0,,... kami Ultimate Magicians izin berangkat!
Dialogue: 0,0:19:28.31,0:19:30.85,Default,,0,0,0,,Benar-benar pemandangan yang menarik.
Dialogue: 0,0:19:32.23,0:19:38.90,Default,,0,0,0,,Tetapi, sudah kuperingatkan bukan? Bahwa jangan pernah menyentuh Shin Wolford.
Dialogue: 0,0:19:39.36,0:19:42.45,Default,,0,0,0,,Tindakan kami memang benar-benar memalukan.
Dialogue: 0,0:19:42.45,0:19:45.83,Default,,0,0,0,,Tidak, aku sangat menikmatinya kok.
Dialogue: 0,0:19:45.83,0:19:47.83,Default,,0,0,0,,Ya, walau sebenarnya,
Dialogue: 0,0:19:48.54,0:19:52.00,Default,,0,0,0,,aku lebih suka kalau kalian berjuang lebih keras lagi.
Dialogue: 0,0:19:55.96,0:19:58.34,Default Italic,,0,0,0,,Shin Wolford ....
Dialogue: 0,0:19:58.34,0:20:03.55,Default Italic,,0,0,0,,Haruskah kami berterimakasih padanya karena telah memberi Tuan kami tujuan baru?
Dialogue: 0,0:20:03.55,0:20:06.18,Default Italic,,0,0,0,,Ataukah, harus kita salahkan dia?
Dialogue: 0,0:20:06.18,0:20:11.18,Default Italic,,0,0,0,,Pokoknya, kekuatannya yang di luar batas tidak bisa diabaikan lagi.
Dialogue: 0,0:20:11.73,0:20:15.65,Default,,0,0,0,,Omong-omong, Miria, bagaimana soal yang itu?
Dialogue: 0,0:20:16.61,0:20:21.99,Default,,0,0,0,,Masih belum pasti. Sepertinya masih perlu verifikasi lebih lanjut.
Dialogue: 0,0:20:22.36,0:20:26.70,Default,,0,0,0,,Begitu ya? Kalau begitu akan kunantikan laporanmu.
Dialogue: 0,0:20:27.70,0:20:33.04,Default Italic,,0,0,0,,Benar. Masa depan kita bergantung pada hasil tersebut.
Dialogue: 0,0:20:38.88,0:20:40.46,Default,,0,0,0,,Tolong ya.
Dialogue: 0,0:20:40.46,0:20:41.84,Default,,0,0,0,,Serahkan pada kami.
Dialogue: 0,0:20:42.34,0:20:44.01,Default,,0,0,0,,Berhati-hatilah.
Dialogue: 0,0:20:44.01,0:20:46.47,Default,,0,0,0,,Pastikan jaga sikapmu di Negeri lain.
Dialogue: 0,0:20:46.47,0:20:48.68,Default,,0,0,0,,Aku tahu kok!
Dialogue: 0,0:20:48.68,0:20:49.93,Default,,0,0,0,,Shin ....
Dialogue: 0,0:20:49.93,0:20:51.31,Default,,0,0,0,,Ya.
Dialogue: 0,0:20:55.52,0:20:57.52,Default,,0,0,0,,Kami berangkat!
Dialogue: 0,0:21:13.62,0:21:18.34,Default,,0,0,0,,August rasanya lebih bahagia sejak ketemu sama Shin ya ....
Dialogue: 0,0:21:19.21,0:21:21.96,Default,,0,0,0,,Ellie masih saja curiga soal itu?
Dialogue: 0,0:21:21.96,0:21:28.35,Default,,0,0,0,,Bukan begitu. Aku dari awal sudah tahu kalau Shin cuma tertarik sama Sicily seorang.
Dialogue: 0,0:21:28.35,0:21:30.56,Default,,0,0,0,,Eh?! Begitu ya?
Dialogue: 0,0:21:30.56,0:21:31.97,Default,,0,0,0,,Terus kenapa selalu dibahas?
Dialogue: 0,0:21:32.72,0:21:36.73,Default,,0,0,0,,Aku iri karena kau selalu bersama dengan Shin.
Dialogue: 0,0:21:36.73,0:21:41.36,Default,,0,0,0,,Jadi aku ingin menjahili kalian soal itu. Maaf ya.
Dialogue: 0,0:21:45.07,0:21:46.49,Default,,0,0,0,,Shin ....
Dialogue: 0,0:21:47.66,0:21:48.82,Default,,0,0,0,,Ya.
Dialogue: 0,0:21:49.32,0:21:51.33,Default,,0,0,0,,Ayo, maju!
Dialogue: 0,0:23:46.32,0:23:48.03,Default,,0,0,0,,Dia sudah pergi ya.
Dialogue: 0,0:23:48.74,0:23:53.99,Default,,0,0,0,,Karena biasanya di sini berisik, pas tenang jadi seperti ada yang kurang ya.
Dialogue: 0,0:23:53.99,0:23:55.53,Default,,0,0,0,,Benar sekali.
Dialogue: 0,0:23:55.91,0:24:01.04,Default,,0,0,0,,Omong-omong, sudah lama kita tidak berduaan seperti ini.
Dialogue: 0,0:24:01.04,0:24:03.71,Default,,0,0,0,,Hentikanlah. Menjijikkan tahu.
Dialogue: 0,0:24:03.71,0:24:05.04,Default,,0,0,0,,Menjijikkan!?
Dialogue: 0,0:24:05.04,0:24:08.05,Default,,0,0,0,,Tapi ya, memang benar sih.
Dialogue: 0,0:24:19.39,0:24:22.69,Default,,0,0,0,,Dasar! Salah siapa sampai teralihkan!
Dialogue: 0,0:24:22.69,0:24:25.44,Default,,0,0,0,,Apa maksudnya tidak menyiapkan tempat tinggal buat kita?!
Dialogue: 0,0:24:25.44,0:24:28.32,Default,,0,0,0,,Mau bagaimana lagi coba? Sebanyak ini orangnya.
Dialogue: 0,0:24:28.32,0:24:30.32,Default,,0,0,0,,Padahal aku ingin berkemah di luar.
Dialogue: 0,0:24:30.32,0:24:32.03,Default,,0,0,0,,Aku sih tidak mau!
Dialogue: 0,0:24:32.03,0:24:34.78,Default,,0,0,0,,Percuma juga memaksakan diri di hari pertama.
Dialogue: 0,0:24:34.78,0:24:37.20,Default,,0,0,0,,Aku ingin lihat kuil.
Dialogue: 0,0:24:37.20,0:24:40.54,Default,,0,0,0,,Pizza itu enak banget ya.
Dialogue: 0,0:24:37.20,0:24:40.54,Default Top,,0,0,0,,Kamar mandi rumah ini lebih baik daripada kuil.
Dialogue: 0,0:24:40.54,0:24:42.87,Default,,0,0,0,,Rasanya sesuai dengan ketenaran restoranya.
Dialogue: 0,0:24:43.21,0:24:49.50,Default,,0,0,0,,OHh, Kakek Merlin, Nenek Melida, maaf mengganggu malam-malam begini.
Dialogue: 0,0:24:49.50,0:24:52.59,Default,,0,0,0,,Oleh karena itu, boleh menginap di sini?
Dialogue: 0,0:24:52.59,0:24:55.26,Default,,0,0,0,,Di tempat Olivia lebih enak makanannya.
Dialogue: 0,0:24:54.30,0:24:55.26,Default Top,,0,0,0,,Aku suka semuanya.
Dialogue: 0,0:24:55.26,0:24:56.64,Default,,0,0,0,,Gadis di jalan tadi imut.
Dialogue: 0,0:24:56.64,0:24:57.76,Default,,0,0,0,,Di jalan mana?
Dialogue: 0,0:24:57.76,0:24:59.22,Default,,0,0,0,,Aku ingin mandi air panas.
Dialogue: 0,0:24:59.22,0:25:00.47,Default,,0,0,0,,Kalian semua!
Dialogue: 0,0:25:00.81,0:25:02.48,Default,,0,0,0,,Jangan berisik!
Dialogue: 0,0:25:02.48,0:25:06.27,Default,,0,0,0,,Baik!
