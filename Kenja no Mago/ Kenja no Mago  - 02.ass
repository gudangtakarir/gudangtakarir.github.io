Dialogue: 1,0:22:30.26,0:22:34.22,ED - Rom,,0,0,0,,{\blur2.5}mugen no kanousei ga hohoenda
Dialogue: 0,0:22:30.26,0:22:34.22,ED - Eng,,0,0,0,,{\blur0.9}Untuk menyampai kebahagian yang terbatas
Dialogue: 0,0:22:34.55,0:22:37.31,ED - Rom,,0,0,0,,{\blur2.5}Kasokudo age mune wo hazume
Dialogue: 0,0:22:34.55,0:22:37.31,ED - Eng,,0,0,0,,{\blur0.9}Busungkan dada dan lakukan dengan cepat
Dialogue: 0,0:22:37.31,0:22:40.18,ED - Rom,,0,0,0,,{\blur2.5}tokutou seki e Here we go, Jump!
Dialogue: 0,0:22:37.31,0:22:40.18,ED - Eng,,0,0,0,,{\blur0.9}Rebut tempat istimewa itu, kita lakukan sekarang, Jump!
Dialogue: 0,0:22:40.18,0:22:44.06,ED - Rom,,0,0,0,,{\blur2.5}karada wo irodoru tenshon atsuku
Dialogue: 0,0:22:40.18,0:22:44.06,ED - Eng,,0,0,0,,{\blur0.9}Ketegangan yang menyelimuti tubuh ini
Dialogue: 0,0:22:44.40,0:22:47.15,ED - Rom,,0,0,0,,{\blur2.5}kankaku dake sukuiageta
Dialogue: 0,0:22:44.40,0:22:47.15,ED - Eng,,0,0,0,,{\blur0.9}Hanya perasaan yang aku rasakan
Dialogue: 0,0:22:47.15,0:22:50.86,ED - Rom,,0,0,0,,{\blur2.5}konshin no ichigeki de Show up!
Dialogue: 0,0:22:47.15,0:22:50.86,ED - Eng,,0,0,0,,{\blur0.9}Di dalam tubuhku hanya ada satu pukulan: Show up!
Dialogue: 0,0:22:50.86,0:22:54.53,ED - Rom,,0,0,0,,{\blur2.5}boku wa issou kagayaketa
Dialogue: 0,0:22:50.86,0:22:54.53,ED - Eng,,0,0,0,,{\blur0.9}Aku semakin bersinar
Dialogue: 0,0:22:54.53,0:22:59.20,ED - Rom,,0,0,0,,{\blur2.5}ikiru imi wo atsumeru hodo ni
Dialogue: 0,0:22:54.53,0:22:59.20,ED - Eng,,0,0,0,,{\blur0.9}Sambil mengumpulkan alasan untuk hidup
Dialogue: 0,0:22:59.20,0:23:04.04,ED - Rom,,0,0,0,,{\blur2.5}saikou & saikyou nichijou no kyasutingu de
Dialogue: 0,0:22:59.20,0:23:04.04,ED - Eng,,0,0,0,,{\blur0.9}Yang terhebat dan terkuat dalam keseharian
Dialogue: 0,0:23:04.04,0:23:08.38,ED - Rom,,0,0,0,,{\blur2.5}Sensation na sutoorii wo Shout out!
Dialogue: 0,0:23:04.04,0:23:08.38,ED - Eng,,0,0,0,,{\blur0.9}Membuat cerita yang menegangkan: Shout out!
Dialogue: 0,0:23:09.51,0:23:11.80,ED - Rom,,0,0,0,,{\blur2.5}Don’t worry! unmei wa taezu
Dialogue: 0,0:23:09.51,0:23:11.80,ED - Eng,,0,0,0,,{\blur0.9}Jangan khawatir! Nasib itu pasti
Dialogue: 0,0:23:11.80,0:23:14.22,ED - Rom,,0,0,0,,{\blur2.5}Everything, Everything hana saku
Dialogue: 0,0:23:11.80,0:23:14.22,ED - Eng,,0,0,0,,{\blur0.9}Semua nya akan bermekaran
Dialogue: 0,0:23:14.84,0:23:19.35,ED - Rom,,0,0,0,,{\blur2.5}umarekawattemo nanmankai mo hikarun da
Dialogue: 0,0:23:14.84,0:23:19.35,ED - Eng,,0,0,0,,{\blur0.9}Jika aku di lahirkan kembali, aku akan lebih kuat seribu kali
Dialogue: 0,0:23:19.35,0:23:21.77,ED - Rom,,0,0,0,,{\blur2.5}Be happy! sekai wo ima
Dialogue: 0,0:23:19.35,0:23:21.77,ED - Eng,,0,0,0,,{\blur0.9}Berbahagiahlah! Di kehidupan sekarang
Dialogue: 0,0:23:21.77,0:23:24.19,ED - Rom,,0,0,0,,{\blur2.5}Everything, Everything tanoshime
Dialogue: 0,0:23:21.77,0:23:24.19,ED - Eng,,0,0,0,,{\blur0.9}Semua nya akan terasa menyenangkan
Dialogue: 0,0:23:24.69,0:23:29.90,ED - Rom,,0,0,0,,{\blur2.5}erabi tsuzukeyou seikai wo kono te ni tsuyoku
Dialogue: 0,0:23:24.69,0:23:29.90,ED - Eng,,0,0,0,,{\blur0.9}Aku akan memilih kehidupan yang kuat di tangan ini
Dialogue: 0,0:23:29.90,0:23:34.36,ED - Rom,,0,0,0,,{\blur2.5}Now or never! shinpai gomuyou
Dialogue: 0,0:23:29.90,0:23:34.36,ED - Eng,,0,0,0,,{\blur0.9}Sekarang atau tidak sama sekali! Jangan pernah khawatir
Dialogue: 0,0:23:34.86,0:23:40.19,ED - Rom,,0,0,0,,{\blur2.5}Happy ending mukaeru kara
Dialogue: 0,0:23:34.86,0:23:40.19,ED - Eng,,0,0,0,,{\blur0.9}Akhir yang bahagia, karena kita bertemu
